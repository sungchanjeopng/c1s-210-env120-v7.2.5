U08 gAd_data[ADC_DATA_MAX];     // OLD: unsigned char Echo_data_array_UC_G[1100];


//--------------------------------------------------------------------------------------------------
//  Local variables
//--------------------------------------------------------------------------------------------------


//--------------------------------------------------------------------------------------------------
//  Global APIs
//--------------------------------------------------------------------------------------------------
// OLD: void Init_ADC0(void)
void AD0_InitBoot(void)
{
	SFRPAGE = ADC0_PAGE;
	ADC0CN  = 0x80;
}

void ADC_InitVari(void)
{
	int i;

	for(i=0; i<ADC_DATA_MAX; i++)
	    gAd_data[i] = 0;
}

// OLD: unsigned int ADC0_convert(unsigned char Sel_ch_UC_L)
U16 AD0_GetRegs(U08 idx)
{
    U16 rtn = 0;
    U08 old;

    old = SFRPAGE;

    SFRPAGE = ADC0_PAGE;

    AD0EN   = 0;
    ADC0CF  = 0xF8;
    ADC0CN  = 0xC0;  	// 0x80;
    AMX0SL  = idx;		// select AIN_chanel
    AD0INT  = 0;		// Clear pending conversion complete indicator
    AD0BUSY = 1;		// Start ADC conversion
    while (!AD0INT);

    rtn = ADC0H;
    rtn = (rtn << 8) | ADC0L;

    SFRPAGE = old;

    return rtn;
}

// OLD: void AD_raw_data_Write(void) 
void ADC_WriteRaw(void)
{
    U32 i;
	U32 addr;
    U08 old = SFRPAGE;

	if(MsANL_GetCtEcho() == 0) return;

	for(i=0; i<ADC_DATA_MAX; i++)
	{
		//MDB_PrcMain();

		addr = (gMm_addr_raw-1) + (i*MnEGN_GetAdcNumb()) + MsANL_GetCtEcho(); 

		MEM_WriteByte(MEM_MRAM, addr, gAd_data[i]);		 // Max : 250000 [220000(ADC Number_MAX*ADC_DATA_MAX)+30000]
		
	}

    SFRPAGE = old;
	//MDB_PrcMain();
}

void ADC_AvrgRaw(void)
{
    U08 i, avg;
    U16 dummy, sum, j;
    U08 old = SFRPAGE;

	if(MsANL_GetCtEcho() == 0) return;

	if(!MEAS_GetFgAdc())		avg = MsANL_GetCtEcho();
	else						avg = MEAS_GetCtAvrg();

    MEM_ReadSeq_StartAddr(MEM_MRAM, gMm_addr_raw);

    for(j=0; j<ADC_DATA_MAX; j++) 
    {
		//MDB_PrcMain();

        sum = 0;

        for(i=0; i<avg; i++)
            sum += MEM_ReadSeq_ByteData(MEM_MRAM);

		//MDB_PrcMain();
        for (i=0; i<(MnEGN_GetAdcNumb()-avg); i++) 
            dummy += MEM_ReadSeq_ByteData(MEM_MRAM);

        gAd_data[j] = sum / avg;

    }
    MEM_RwSeq_End(MEM_MRAM);  							// Max : 250000 [220000(ADC Number_MAX*ADC_DATA_MAX)+30000]

    SFRPAGE = old;
	/MDB_PrcMain();
}

void ADC_ProcSmooth(U16 num, U16 size) 
{
    U16 sum;
    U16 i, j, k;
    U08 move, cnt;

    cnt = 3;

    for(i=0; i<num; i++) 
    {
        cnt = 3;
        for(j=1; j<size; j++) 
        {
       MDB_PrcMain();
        	move = 1;
        	
        	for (k=0; k<j; k++) 
        	{
        		sum += gAd_data[j+move];
        		sum += gAd_data[j-move];
        		move++;
        	}
        	
        	sum += gAd_data[j];
        	gAd_data[j] = (U08)(sum / cnt);
        	cnt += 2;
        	sum = 0;
        }

        for(j= size; j<ADC_DATA_MAX-size; j++)
        {
        	move = 1;
        	
        	for (k = 0; k < size; k++) 
        	{
        		sum += gAd_data[j+move];
        		sum += gAd_data[j-move];
        		move++;
        	}
        	
        	sum += gAd_data[j];
        	gAd_data[j] = (U08)(sum / ((size * 2) + 1));
        	sum = 0;
        }

        cnt = (size * 2) - 1;

        for(j=ADC_DATA_MAX-size; j<ADC_DATA_MAX; j++) 
        {
        	move = 1;
        	
        	for(k=size; k>1; k--) 
        	{
        		sum += gAd_data[j+move];
        		sum += gAd_data[j-move];
        		move++;
        	}
        	sum += gAd_data[j];

        	if(cnt == 0)    gAd_data[j] = 0;
        	else            gAd_data[j] = (U08)(sum / cnt);

        	cnt -= 2;
        	size--;
        	sum = 0;
        }
    }
}

// OLD: void ADC_Echo(void) 
void ADC_PrcEcho(void) 
{
	U16 i;
	U08 old = SFRPAGE;

	SFRPAGE = CONFIG_PAGE;
	SBIT_P6_B6 = 1;

	SFRPAGE = ADC0_PAGE;        //ADC0_PAGE 0x00, TMR2_PAGE 0x00, LEGACY_PAGE 0x00
	AD0INT  = 0;
	SFRPAGE = TMR2_PAGE;
	TR2 = 1;

	for(i=10; i<ADC_DATA_MAX; i++) 
	{
		SFRPAGE = ADC0_PAGE;
		while(!AD0INT);

		TF2 = 0;
		AD0INT = 0;

		gAd_data[i] = ADC0H;

		SFRPAGE = CONFIG_PAGE;
		SBIT_P6_B6 = ~SBIT_P6_B6;
	}

	SFRPAGE = TMR2_PAGE;
	TR2 = 0;
	TF2 = 0;

	SFRPAGE = old;
}


