  78          void TstDp_ListP1(U08* pSel)
  79          {
  80   1        U08 *pStr = "   ";
  81   1        U08 c  = MnTST_L00_IDLE + 1;
  82   1        U08 ft = FT_EN_08x16;
  83   1                                  //   0123456789abcdef0123456789abcde
  84   1        MnLST_DispStr(ft, FALSE,   MnTST_L00_IDLE+1,      "           TEST                ");
  85   1        MnLST_DispStr(ft, pSel[c++], MnTST_L01_GLOVAL_CNT+1,  "Global Counter                 ");
  86   1      
