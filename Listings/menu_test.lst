  98          void MnTstDp_List(U08 sel)
  99          {
 100   1        U08 i;
 101   1        U08 page = MNU_PAGE_01;
C51 COMPILER V9.55   MENU_TEST                                                             04/29/2026 17:23:17 PAGE 3   

 102   1        U08 font = FT_EN_08x16;
 103   1        U08 pSel[MnTST_LST_MAX] = {0, };
 104   1      
 105   1        pSel[sel] = TRUE;
 106   1      
 107   1        if    (sel > (MNU_LIST_NUM*2))    page = MNU_PAGE_03;
 108   1        else if (sel > (MNU_LIST_NUM*1))    page = MNU_PAGE_02;
 109   1        else                  page = MNU_PAGE_01;
 110   1      
 111   1        if    (sel > (MNU_LIST_NUM*2))    pSel[sel-(MNU_LIST_NUM*2)] = TRUE;
 112   1        else if (sel > (MNU_LIST_NUM*1))    pSel[sel-(MNU_LIST_NUM*1)] = TRUE;
 113   1        else                  pSel[sel-(MNU_LIST_NUM*0)] = TRUE;
 114   1      
 115   1        if(page > MNU_PAGE_01)
 116   1          return;
 117   1      
 118   1        TstDp_ListP1(pSel);
 119   1      
 120   1        for(i=(MnTST_LST_MAX+1); i<=(MNU_LIST_NUM+1); i++)
 121   1          MnLST_DispClr(i);
 122   1      
 123   1          LDT_UpdBuff(LCD_Y_START,LCD_Y_END);
 124   1        DLY_RunMsec(100);
 125   1      
 126   1      
 127   1      }
