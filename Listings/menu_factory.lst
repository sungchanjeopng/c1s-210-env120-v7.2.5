  49          void FtrP1_L01_02_SetDac(U08 lst)
  50          {
  51   1        U16 old;
  52   1        U16 sel;
  53   1        U16 max;
  54   1        U16 min;
  55   1        U08 cnt = 0;
  56   1      
  57   1        switch(lst)
  58   1        {
  59   2          case MnFTR_L01_DAC_04mA:  old = lMnFtr.dac_04mA;      break;
  60   2          case MnFTR_L02_DAC_20mA:  old = lMnFtr.dac_20mA;      break;
  61   2          default:          return;
  62   2        }
  63   1      
  64   1        switch(lst)
  65   1        {
  66   2          case MnFTR_L01_DAC_04mA:  min = MnFTR_DAC_04mA_MIN; max = MnFTR_DAC_04mA_MAX;   break;
  67   2          case MnFTR_L02_DAC_20mA:  min = MnFTR_DAC_20mA_MIN; max = MnFTR_DAC_20mA_MAX;   break;
  68   2        }
  69   1      
  70   1        sel = old;
  71   1      
  72   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X10, MnBOX_Y01, F_F, "DAC");
  73   1        DpSTR_NumbUpd(MnBOX_Y03, sel, max, 0, F_F, "");
  74   1      
  75   1        DAC_OutSpi(sel);
  76   1        DLY_RunMsec(BTN_WAIT_UD);
  77   1      
  78   1        do 
  79   1        {
  80   2          if(!_SBIT_BTN_UP || !_SBIT_BTN_DOWN)
  81   2          {
  82   3            if(++cnt >= 30)
  83   3              cnt = 30;
  84   3      
  85   3            sel = BTN_GetValue_UpDn(sel, min, max, 1, cnt);
  86   3            DpSTR_NumbUpd(MnBOX_Y03, sel, max, 0, F_F, "");
  87   3            DAC_OutSpi(sel);
  88   3      
  89   3            BTN_DelayMsec(BTN_WAIT_UD);
  90   3          } 
  91   2          else
  92   2            cnt = 0;
  93   2        } 
  94   1        while(_SBIT_BTN_SET && _SBIT_BTN_EXIT);
  95   1      
  96   1        if((sel != old) && !_SBIT_BTN_SET)
  97   1        {
  98   2          switch(lst)
  99   2          {
 100   3            case MnFTR_L01_DAC_04mA:  lMnFtr.dac_04mA = sel;    break;
 101   3            case MnFTR_L02_DAC_20mA:  lMnFtr.dac_20mA = sel;    break;
 102   3          }
 103   2      
 104   2          lMnFtr.dac_38mA = lMnFtr.dac_04mA - ((((lMnFtr.dac_20mA - lMnFtr.dac_04mA) + 5) / 8) / 10);
C51 COMPILER V9.55   MENU_FACTORY                                                          04/29/2026 17:23:33 PAGE 3   

 105   2          lMnFtr.dac_21mA = lMnFtr.dac_20mA + (  (lMnFtr.dac_20mA - lMnFtr.dac_04mA) / 16);
 106   2        }
 107   1      }
