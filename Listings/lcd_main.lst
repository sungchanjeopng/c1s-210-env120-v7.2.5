 113          // OLD: void GLCD_240_Busy_wait(void)
 114          void LCD_ChkBusy(void)
 115          {
C51 COMPILER V9.55   LCD_MAIN                                                              04/29/2026 17:21:46 PAGE 3   

 116   1          char dat;
