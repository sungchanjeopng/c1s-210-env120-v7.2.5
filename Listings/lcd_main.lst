 154          void LCD_InitErase(void)
 155          {
 156   1        int x, y;
 157   1      
 158   1        /* loops to write whole LCD memory to a blank pattern */
 159   1        LCD_TxCmd2(0x24,0);     /* setup the AP to 0 */
 160   1      
 161   1        for(x=0; x<LDT_BUFF_SIZE_X; x++)
 162   1          for(y=0; y<LDT_BUFF_SIZE_Y; y++)
 163   1            LCD_TxCmd1(0xC0,0);
