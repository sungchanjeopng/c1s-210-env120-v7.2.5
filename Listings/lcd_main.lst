 140          
 141          // OLD: void GLCD_240_Cmd_2(char cmd,unsigned int parm)
 142          void LCD_TxCmd2(char cmd,unsigned int parm)
 143          {
 144   1        SFRPAGE = CONFIG_PAGE;
 145   1        LCD_ChkBusy();          /* wait for the status */
 146   1        LCD_CfgData(parm&0xFF);       /* send out the low byte of the data */
 147   1        LCD_ChkBusy();          /* wait again for status */
 148   1        LCD_CfgData(parm>>8);       /* send out the high byte of the data */
 149   1        LCD_ChkBusy();          /* wait for status on command */
 150   1        LCD_CfgCtrl(cmd);         /* send out the command itself */
 151   1      }
