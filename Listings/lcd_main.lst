 131          // OLD: void GLCD_240_Cmd_1(char cmd,unsigned char parm)
 132          void LCD_TxCmd1(char cmd, unsigned char parm)
 133          {
 134   1        SFRPAGE = CONFIG_PAGE;
 135   1        LCD_ChkBusy();          /* wait for the status */
