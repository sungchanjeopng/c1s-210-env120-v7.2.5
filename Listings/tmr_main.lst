  53          void TMR_InitBoot(void) 
C51 COMPILER V9.55   TMR_MAIN                                                              04/29/2026 17:22:26 PAGE 2   

  54          {
  55   1        // Disable watchdog timer
  56   1        WDTCN = 0xde;
  57   1        WDTCN = 0xad;
  58   1      
  59   1        SFRPAGE = TIMER01_PAGE;
  60   1        TCON  = 0x40;       // ENV100-M Enable Timer1 to UART1
  61   1        TMOD  = 0x21;       // tmr1 8bit couneter/timer with auto-reload, tmr0 16bit counter/timer 
  62   1        CKCON = 0x02;       // tmr0,1 prescaled clk devied by 48
  63   1        
  64   1        TH1 = 0xBF;       // ENV100-M UART 1 BPS 9600
  65   1        TH0 = 0x00;       // ENV100-M UART 1 BPS 9600
  66   1      
  67   1        // TVG curve
  68   1        TH0 = 0xFE;         // 20Cm = 270.27us - 270.27us / ((1 / SYSCLK_E100) * 48) = 338, ffff - 152(338) = FEAD
  69   1        TL0 = 0xAD;       // ex) TH0 = 0xFF; //TL0 = 0x56;  // 10Cm
  70   1        
  71   1        SFRPAGE = TMR2_PAGE;
  72   1        TMR2CF  = 0x08;     // ADC interval
  73   1      
  74   1        SFRPAGE = TMR3_PAGE;  // Timer3 : 1sec delay
  75   1        RCAP3H = 0x3C;
  76   1        RCAP3L = 0xAF;      // (1 / 60 Mhz) * 12 = 200 ns : 10 ms / 200 ns = 50000, ffff - c350(50000) = 3caf
  77   1        TMR3CN = 0x04;
  78   1        TMR3H  = 0x3C;
  79   1        TMR3L  = 0xAF;
