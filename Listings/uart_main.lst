 197   1        S16 dista_ft = MsANL_GetDistaFt();
 198   1      
 199   1        SFRPAGE = UART0_PAGE;
 200   1      
 201   1        UT0_TxByte(0x0d);    //CR
 202   1        UT0_TxByte(0x0a);    //LF
 203   1      
 204   1        UT0_TxByte(0x44);    //'D'
 205   1      
 206   1        if(unit == MnMSR_UNIT_FEET)
 207   1        {
 208   2          gDp_buff_str[0] = (dista_ft / 1000) % 10 + '0';
 209   2          gDp_buff_str[1] = (dista_ft /  100) % 10 + '0';
 210   2          gDp_buff_str[2] = (dista_ft /   10) % 10 + '0';
 211   2          gDp_buff_str[3] =  dista_ft         % 10 + '0';
 212   2        }
 213   1        else
 214   1        {
 215   2          gDp_buff_str[0] = (dista_mt / 1000) % 10 + '0';
 216   2          gDp_buff_str[1] = (dista_mt /  100) % 10 + '0';
 217   2          gDp_buff_str[2] = (dista_mt /   10) % 10 + '0';
 218   2          gDp_buff_str[3] =  dista_mt         % 10 + '0';
 219   2        }
 220   1      
 221   1        for(i=0; i<4; i++)                     //'Transfer Rag Level, unit 000cm
 222   1          UT0_TxByte(gDp_buff_str[i]);
 223   1      
 224   1        UT0_TxByte(0x53);    //'S'
C51 COMPILER V9.55   UART_MAIN                                                             04/29/2026 17:22:47 PAGE 5   

 225   1      
 226   1        if(unit == MnMSR_UNIT_FEET)
 227   1        {
 228   2          gDp_buff_str[0] = (level_ft / 1000) % 10 + '0';
 229   2          gDp_buff_str[1] = (level_ft /  100) % 10 + '0';
 230   2          gDp_buff_str[2] = (level_ft /   10) % 10 + '0';
 231   2          gDp_buff_str[3] =  level_ft         % 10 + '0';
 232   2        }
 233   1        else
 234   1        {
 235   2          gDp_buff_str[0] = (level_mt / 1000) % 10 + '0';
 236   2          gDp_buff_str[1] = (level_mt /  100) % 10 + '0';
 237   2          gDp_buff_str[2] = (level_mt /   10) % 10 + '0';
 238   2          gDp_buff_str[3] =  level_mt         % 10 + '0';
 239   2        }
 240   1      
 241   1        for (i = 0; i < 4; i++)                   //Transfer Sludge Level, 000unit cm
 242   1          UT0_TxByte(gDp_buff_str[i]);
 243   1      
 244   1        UT0_TxByte(0x54);   //'T'
 245   1        tmp2 = gTp_now;         //Trasnfer Temperature, 00unit 1'
 246   1      
 247   1        if (tmp2 < 0)
 248   1        {
 249   2          gDp_buff_str[0] = 0x2d;      //'-'
 250   2          tmp2 = tmp2 * -1;
 251   2        }
 252   1        else
 253   1          gDp_buff_str[0] = 0x2b;      //'+'
 254   1      
 255   1        gDp_buff_str[1] = (tmp2 / 100) % 10 + '0';
 256   1        gDp_buff_str[2] = (tmp2 /  10) % 10 + '0';
 257   1      
 258   1        for (i=0; i<3; i++)
 259   1          UT0_TxByte(gDp_buff_str[i]);
 260   1      
 261   1        UT0_TxByte(0x45);   // 'E'
 262   1      
 263   1        switch(MsANL_GetErrStat())
 264   1        {
 265   2          case MsANL_ERR_NONE:    UT0_TxByte(0x30);   UT0_TxByte(0x30);   break;    // '00'
 266   2          case MsANL_ERR_ECHO:    UT0_TxByte(0x30);   UT0_TxByte(0x31);   break;    // '01'
 267   2          case MsANL_ERR_TPRT:    UT0_TxByte(0x30);   UT0_TxByte(0x32);   break;    // '02'
 268   2        }
 269   1      
 270   1        UT0_TxByte(0x00);    // NULL
 271   1      
 272   1        SFRPAGE = old;
 273   1      }
