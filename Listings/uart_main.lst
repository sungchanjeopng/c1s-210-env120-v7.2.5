 188          void Ut0Tx_Standard(void)
 189          {
 190   1        U08 i;
 191   1        S16 tmp2;
 192   1        U08 old = SFRPAGE;
 193   1        U08 unit = MnMSR_GetUnit();
 194   1        S16 level_mt = MsANL_GetLevelMt();
