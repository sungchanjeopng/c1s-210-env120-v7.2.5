 127          void UAT_SetBaudrate(U08 val)
 128          {
 129   1          U08 old = SFRPAGE;
 130   1      
 131   1          SFRPAGE = TMR4_PAGE;
 132   1          TR4   = ISR_ITR_DISABLE;
 133   1      
 134   1          switch(val)
 135   1          {
 136   2          case MnOUT_MDB_BAUD_04800:  RCAP4H = 0xFC;  RCAP4L = 0xF3;  gUt.baud_cfg = 3600;  break;  // 720*(60/12)
 137   2          case MnOUT_MDB_BAUD_09600:  RCAP4H = 0xFE;  RCAP4L = 0x79;  gUt.baud_cfg = 1795;  break;  // 179*(60/12)
 138   2          case MnOUT_MDB_BAUD_19200:  RCAP4H = 0xFF;  RCAP4L = 0x3D;  gUt.baud_cfg = 895;   break;
 139   2          }
 140   1      
 141   1          gUt.baud_cnt = gUt.baud_cfg;
 142   1      
 143   1          TR4   = 1;
 144   1          SFRPAGE = old;
 145   1      }
