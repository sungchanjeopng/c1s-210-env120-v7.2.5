  54          //--------------------------------------------------------------------
  55          // OLD: void Init_Voltage_Reference(void)
  56          void ETC_InitVoltRef(void)
  57          {
  58   1        SFRPAGE = LEGACY_PAGE;
  59   1        REF0CN = 0x07;
  60   1      }
  61          
  62          // OLD: void Init_Oscillator(void)
  63          void ETC_InitOsc(void)
  64          {
  65   1        int i = 0;
  66   1      
  67   1        SFRPAGE = CONFIG_PAGE;
  68   1      
  69   1        OSCXCN = 0x67;                // external osc control, crystal osc mode, 10~30mhz
  70   1        
  71   1        for(i=0; i<3000; i++);      // Wait 1ms for initialization
  72   1        while((OSCXCN & 0x80) == 0);
  73   1        
  74   1        PLL0CN = 0x04;
  75   1        CCH0CN &= ~0x20;
  76   1        SFRPAGE = LEGACY_PAGE;
  77   1        FLSCL = 0xA0;                // sys clock 75mhz 이하
  78   1      
  79   1        SFRPAGE = CONFIG_PAGE;
  80   1        CCH0CN |= 0x20;
  81   1        PLL0CN |= 0x01;   // pll on
  82   1        PLL0DIV = 0x01;   // 나누기 1 
  83   1        PLL0FLT = 0x17;   // 45~90mhz, 7.8~12.5mhz
  84   1        PLL0MUL = 0x05;   // 곱하기 5
  85   1        
  86   1        for (i=0; i<15; i++);  // Wait 5us for initialization
  87   1        
  88   1        PLL0CN |= 0x02;   // pll enable
  89   1        
  90   1        while((PLL0CN & 0x10) == 0);  // pll frequency is locked
  91   1        
  92   1        CLKSEL = 0x02;    // sys clk from pll
  93   1        OSCICN &= ~0x80;  // programmed internal osc is devided by 1
  94   1      }
