1140          U16 DSP_GetCurrent(void)
1141          {
1142   1          U16 current;
1143   1        U16 curr_04ma, curr_20ma;
1144   1          F32 dg_c;
1145   1          F32 dg_data  = MEAS_GetSgThick();
1146   1        U16 set04mA  = MnOUT_GetSet04mA();
1147   1        U16 set20mA  = MnOUT_GetSet20mA();
1148   1        U08 echo_out = MnOUT_GetEchoOut();
1149   1      
1150   1        switch(MnMSR_GetUnit())
1151   1        {
1152   2          case MnMSR_UNIT_METER:
1153   2            curr_04ma = set04mA;
1154   2            curr_20ma = set20mA;
1155   2            break;
1156   2          case MnMSR_UNIT_FEET:
1157   2            curr_04ma = (U16)((F32)set04mA * MSR_CALC_M2F_CONST); //+ 0.5;
1158   2            curr_20ma = (U16)((F32)set20mA * MSR_CALC_M2F_CONST); //+ 0.5;
1159   2            break;
C51 COMPILER V9.55   DISP_MAIN                                                             04/29/2026 17:22:20 PAGE 20  

1160   2        }
1161   1      
1162   1        dg_c = (16.0 / (curr_20ma - curr_04ma)) * (dg_data - curr_04ma) + 4.0;
1163   1        
1164   1          if (dg_c < 4)       dg_c = 4;
1165   1          if (dg_c > 20)      dg_c = 20;
1166   1      
1167   1          current = dg_c * 100;
1168   1      
1169   1          if(MsANL_GetFgErr())
1170   1          {
1171   2              if(echo_out == MnOUT_ECHO_OUT_38mA)     current = 380;
1172   2              if(echo_out == MnOUT_ECHO_OUT_21mA)     current = 2100;
1173   2          }
1174   1      
1175   1          return current;
1176   1      }
