1118          void DSP_SetBuff(U16 width, U08 *p_val, U16 start, U32 end)
1119          {
1120   1          U16 i;
1121   1          U32 aux;
1122   1          F32 interval;
1123   1          F32 idx = 0;
1124   1          U08 old = SFRPAGE;
1125   1      
1126   1          SFRPAGE = CONFIG_PAGE;
1127   1      
1128   1          interval = (end - start) / (width * 1.0);
1129   1      
1130   1          for(i=0; i<width; i++)
1131   1          {
1132   2            aux = idx;
1133   2            gDp_buff_grp[i] = *(p_val + aux);
1134   2            idx += interval;
1135   2          }
1136   1      
1137   1          SFRPAGE = old;
1138   1      }
