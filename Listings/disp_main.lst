1211          void DSP_DrawGraph(U16 x_start, U16 y_start, U16 x_width, U16 y_height, U08* p_val,
1212                     U16 idx_start, U32 idx_end, U16 max, U08 type)
1213          {
1214   1          U32 aux;
1215   1          U16 i, dat1, height, deadzone;
1216   1        F32 dat2;
1217   1          F32 ratio_y, interval, idx_aux;
1218   1          U08 old = SFRPAGE;
1219   1      
1220   1          SFRPAGE = CONFIG_PAGE;
1221   1        
C51 COMPILER V9.55   DISP_MAIN                                                             04/29/2026 17:22:20 PAGE 21  

1222   1          height   = y_start + y_height;
1223   1          ratio_y  = y_height / (max * 1.0);
1224   1          interval = (idx_end - idx_start) / (x_width * 1.0);
1225   1          idx_aux  = 0;
1226   1      
1227   1          dat2     = MsANL_GetTrhdPct() * (y_height / 240.0);
1228   1          deadzone = (220 * (U32)MnMSR_GetDead()) / (U32)MsANL_GetEmpty();
1229   1      
1230   1          for(i=x_start; i<(x_start+x_width); i++)
1231   1          {
1232   2              aux = idx_aux;
1233   2              dat1 = *(p_val + aux) * ratio_y;
1234   2              idx_aux += interval;
1235   2      
1236   2          LDT_LineVert(i, y_start, height, LDT_LINE_CLEAR);
1237   2      
1238   2              switch(type)
1239   2              {
1240   3                  case DP_IDX_GRAPH_1:
1241   3                      if(i > deadzone)
1242   3                LDT_LineVert(i, height-dat1, height, LDT_LINE_DATA);
1243   3                      break;
1244   3      
1245   3                  case DP_IDX_GRAPH_2: 
1246   3                      if(i > deadzone)
1247   3                      {
1248   4                LDT_LineVert(i, height-dat1, height, LDT_LINE_DATA);
1249   4      
1250   4                        if((i % 2) == 0)
1251   4                          {
1252   5                              if(dat1 > dat2)         LDT_ClearDot(i, height - dat2);
1253   5                              else                    LCD_DataDot_Buff(i, height - dat2);
1254   5                          }
1255   4                      }
1256   3                    break;
1257   3      
1258   3                  case DP_IDX_GRAPH_3:
1259   3                      LCD_DataDot_Buff(i, height - dat1);
1260   3                      break;
1261   3                  case DP_IDX_GRAPH_4:
1262   3              LDT_LineVert(i, height-dat1, height, LDT_LINE_DATA);
1263   3      
1264   3              #if 1
1265   3              if((i % 2) == 0)
1266   3              {
1267   4                if(dat1 > dat2)     LDT_ClearDot(i, height - dat2);
1268   4                else          LCD_DataDot_Buff(i, height - dat2);
1269   4              }
1270   3              #endif
1271   3              break;
1272   3              }
1273   2          }
1274   1      
1275   1          DspDrw_AxisY(x_start, y_start, x_width, y_height, type);
1276   1      
1277   1          SFRPAGE = old;
1278   1      }
