 103          void MnSys_Time(void)
 104          {
 105   1        int i;
 106   1        U08 p_str[APP_STR_LENGTH] = {0, };
 107   1        U08 p_st2[APP_STR_LENGTH] = {0, };
 108   1        U08 p_st3[APP_STR_LENGTH] = {0, };
