 591          void MnSYS_ProcMain(void)
 592          {
 593   1        U32 cnt = 0;
 594   1        U08 fDp = FALSE;
 595   1        U08 sel = MnSYS_L00_IDLE + 1;
 596   1      
 597   1        SysDp_ProcList(sel);
 598   1      
 599   1        do
 600   1        {
 601   2            if(!_SBIT_BTN_DOWN)
 602   2            {
 603   3              if(sel < (MnSYS_LST_MAX-1))   sel++;
 604   3              else                            sel = (MnSYS_L00_IDLE+1);
 605   3            fDp = TRUE;
 606   3            }
 607   2      
 608   2            if(!_SBIT_BTN_UP)
 609   2            {
 610   3                if(sel > (MnSYS_L00_IDLE+1))  sel--;
 611   3                else                          sel = (MnSYS_LST_MAX-1);
 612   3            fDp = TRUE;
 613   3            }
 614   2      
 615   2          if(!_SBIT_BTN_RIGHT && !_SBIT_BTN_LEFT)
 616   2          {
 617   3            if(++cnt > 800000)
 618   3            {
 619   4              MnEGN_ProcMain();
 620   4              cnt = 0;
 621   4              fDp = TRUE;
 622   4            }     
 623   3          }
 624   2          else
 625   2            cnt = 0;
 626   2      
 627   2            if(!_SBIT_BTN_SET)
 628   2            {
 629   3            switch(sel)
 630   3            { // Page 1
 631   4              case MnSYS_L01_PASSCODE:  MnSys_Password();   break;
 632   4              case MnSYS_L02_LANG:    MnSys_Language();   break;
 633   4              case MnSYS_L03_TIME:    MnSys_Time();     break;
 634   4              case MnSYS_L04_VERSION:   MnSys_Version();    break;
 635   4              // Page 2
 636   4            }
 637   3            fDp = TRUE;
C51 COMPILER V9.55   MENU_SYSTEM                                                           04/29/2026 17:23:30 PAGE 12  

 638   3            }
 639   2      
 640   2          if(fDp)
 641   2          {
 642   3            SysDp_ProcList(sel);
 643   3            fDp = FALSE;
 644   3          }
 645   2        }
 646   1        while(_SBIT_BTN_EXIT);
 647   1      }
