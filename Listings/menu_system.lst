 110   1        MnBOX_DispBox();
 111   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X10, MnBOX_Y01, F_F, "Year");
 112   1        DpSTR_LineUpd(FT_EN_08x16, 0, 139, 64, "20  ");
 113   1        APP_Num2Str(gRt.yy, p_str, 2, 0, TRUE);
 114   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 157, 64, p_str);
 115   1        BTN_DelayMsec(BTN_WAIT_SET);
 116   1        gRt.yy = RTC_AdjTime(gRt.yy, 157, 64, RTC_SET_IDX_YY);
 117   1      
