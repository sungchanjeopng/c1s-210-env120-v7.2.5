 529          void SysChk_Vari(void)
 530          {
 531   1        if(lMnSys.pass >= MnSYS_PASS_MAX)     lMnSys.pass = MnSYS_PASS_DFT;
 532   1        if(lMnSys.lang >= MnSYS_LANG_MAX)     lMnSys.lang = MnSYS_LANG_ENG;
 533   1      
 534   1      #if defined (_FT_LANG_KR)
                lMnSys.loc = MnSYS_LOC_KOR;
              
              #elif defined (_FT_LANG_CN)
                lMnSys.loc = MnSYS_LOC_CHN;
              
              #elif defined (_FT_LANG_JP)
 541   1        lMnSys.loc = MnSYS_LOC_JPN;
 542   1      
 543   1      #else
                lMnSys.loc = MnSYS_LOC_KOR;
              
              #endif
 547   1      }
