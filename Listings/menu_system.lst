 144   1      
 145   1          // HH:MM
 146   1        DpSTR_LineUpd(FT_EN_08x16, 0, 136, 64, "  :  ");
 147   1        APP_Num2Str(gRt.hour, p_st2, 2, 0, TRUE);
 148   1        APP_Num2Str(gRt.min,  p_st3, 2, 0, TRUE);
 149   1      
 150   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 136, 64, p_st2);
 151   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 163, 64, p_st3);
 152   1      
 153   1        BTN_DelayMsec(BTN_WAIT_SET);
 154   1        gRt.hour = RTC_AdjTime(gRt.hour, 136, 64, 4);
 155   1      
 156   1        BTN_DelayMsec(BTN_WAIT_SET);
 157   1        gRt.min  = RTC_AdjTime(gRt.min, 163, 64, 5);
 158   1      
 159   1        RTC_SetTime(gRt.min, gRt.hour, gRt.date, gRt.mm, gRt.dd, gRt.yy);
 160   1      
 161   1        if(MnDAT_GetFgSave()) 
 162   1        {
 163   2              RTC_GetTime();
