 124   1        APP_Num2Str(gRt.date, p_st3, 2, 0, TRUE);
 125   1      
 126   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 137, 64, p_st2);
 127   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 163, 64, p_st3);
 128   1      
 129   1        for(i=0; i<APP_STR_LENGTH; i++)
 130   1        {
 131   2          p_str[i] = 0;
 132   2          p_st2[i] = 0;
 133   2          p_st3[i] = 0;
 134   2        }
 135   1        BTN_DelayMsec(BTN_WAIT_SET);
 136   1        gRt.mm = RTC_AdjTime(gRt.mm, 136, 64, RTC_SET_IDX_MM);
 137   1        BTN_DelayMsec(BTN_WAIT_SET);
 138   1      
 139   1          // Date
 140   1        gRt.date = RTC_AdjTime(gRt.date, 163, 64, 3);
 141   1      
 142   1          // Time
