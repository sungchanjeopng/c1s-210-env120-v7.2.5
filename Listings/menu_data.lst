 236          void MnDat_DpTerm(void)
 237          {
 238   1        U08 *pS0, *pS1;
 239   1        U08 old, sel;
 240   1        U08 f_dsp = FALSE;
 241   1      
 242   1        MnBOX_DispBox();
 243   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X10, MnBOX_Y01, F_F, "Time");
 244   1        BTN_DelayMsec(BTN_WAIT_UD);
 245   1      
 246   1        switch(lMnDat.sav_intv)
 247   1        {
 248   2          case MnDAT_INTV_01M:  old = lMnDat.disp_01m;    break;
 249   2          case MnDAT_INTV_10M:  old = lMnDat.disp_10m;    break;
 250   2          case MnDAT_INTV_60M:  old = lMnDat.disp_60m;    break;
 251   2        }
 252   1      
 253   1        sel = old;
 254   1      
 255   1        do
 256   1        {
 257   2          if(!_SBIT_BTN_UP || !_SBIT_BTN_DOWN)
 258   2          {
 259   3            LDT_ClrBuff(MnBOX_LEFT, MnBOX_TOP+2+32, MnBOX_RIGHT-2, MnBOX_BOTTOM-2);
 260   3            BTN_DelayMsec(BTN_WAIT_UD);
 261   3      
 262   3            if(++sel > 1)
 263   3              sel = 0;
 264   3          }
 265   2      
 266   2          switch(lMnDat.sav_intv)
 267   2          {
 268   3            case MnDAT_INTV_01M:
 269   3              pS0 = "(hrs)";
 270   3      
 271   3              switch(sel)
 272   3              {
 273   4                case MnDAT_DISP_I0:   pS1 = "12";   break;
 274   4                case MnDAT_DISP_I1:   pS1 = "24";   break;
 275   4              }
 276   3      
 277   3              break;
 278   3      
 279   3            case MnDAT_INTV_10M:
 280   3              pS0 = "(days)";
 281   3              switch(sel)
 282   3              {
 283   4                case MnDAT_DISP_I0:   pS1 = "1";    break;
C51 COMPILER V9.55   MENU_DATA                                                             04/29/2026 17:23:07 PAGE 6   

 284   4                case MnDAT_DISP_I1:   pS1 = "7";      break;
 285   4              }
 286   3              break;
 287   3      
 288   3            case MnDAT_INTV_60M:
 289   3              pS0 = "(days)";
 290   3              switch(sel)
 291   3              {
 292   4                case MnDAT_DISP_I0:   pS1 = "14";   break;
 293   4                case MnDAT_DISP_I1:   pS1 = "30";   break;
 294   4              }
 295   3              break;
 296   3          }
 297   2      
 298   2          MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X09, MnBOX_Y02, F_F, pS0);
 299   2          MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X12, MnBOX_Y03, F_F, pS1);
 300   2          LDT_UpdBuff(LCD_Y_START,LCD_Y_END);
 301   2        }
 302   1        while(_SBIT_BTN_SET && _SBIT_BTN_EXIT);
 303   1      
 304   1        if(!_SBIT_BTN_SET)
 305   1        {
 306   2          switch(lMnDat.sav_intv)
 307   2          {
 308   3            case MnDAT_INTV_01M:  lMnDat.disp_01m = sel;    break;
 309   3            case MnDAT_INTV_10M:  lMnDat.disp_10m = sel;    break;
 310   3            case MnDAT_INTV_60M:  lMnDat.disp_60m = sel;    break;
 311   3          }
 312   2        }
 313   1      }
