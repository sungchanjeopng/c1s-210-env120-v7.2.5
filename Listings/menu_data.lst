 172          void MnDat_Interval(void)
 173          {
 174   1        S16 old = lMnDat.sav_intv;
 175   1        S16 sel = old;
 176   1      
 177   1        MnBOX_DispBox();
 178   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X10, MnBOX_Y01, F_F, "Time");
 179   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X09, MnBOX_Y02, F_F, "(min)");
 180   1        BTN_DelayMsec(BTN_WAIT_UD);
 181   1        sel = MnBOX_SelArg4(MnSYS_LANG_ENG, sel, MnBOX_X13, "1", MnBOX_X12, "10", MnBOX_X12, "60", 0, "", 3);
 182   1      
 183   1        if(!_SBIT_BTN_EXIT)
 184   1          return;
 185   1      
 186   1        if(sel != old)
 187   1          lMnDat.sav_intv = sel;
 188   1      
 189   1        DISP_ClearScr();
 190   1        DpSTR_LineUpd(FT_EN_08x16, F_F, 20, 0,  "The logged data");
 191   1        DpSTR_LineUpd(FT_EN_08x16, F_F, 20, 16, "will be deleted");
 192   1        DpSTR_LineUpd(FT_EN_08x16, F_F, 32, 48, "OK - SAVE");
 193   1        DpSTR_LineUpd(FT_EN_08x16, F_F, 32, 80, "NO - EXIT");
 194   1        BTN_DelayMsec(BTN_WAIT_SET);
 195   1      
 196   1        while(_SBIT_BTN_SET && _SBIT_BTN_EXIT);
 197   1      
 198   1        if(!_SBIT_BTN_EXIT)
 199   1        {
 200   2          lMnDat.sav_intv = old;
 201   2          return;
 202   2        }
 203   1        
 204   1        DISP_ClearScr();
 205   1        DpSTR_LineUpd(FT_EN_08x16, F_F, 28, 16,"Max. Log Time");
 206   1      
 207   1        switch(lMnDat.sav_intv)
 208   1        {
 209   2          case MnDAT_INTV_01M:  DpSTR_LineUpd(FT_EN_08x16, F_F, 4, 48,"  6 days from now on");    break;
 210   2          case MnDAT_INTV_10M:  DpSTR_LineUpd(FT_EN_08x16, F_F, 4, 48," 60 days from now on");    break;
 211   2          case MnDAT_INTV_60M:  DpSTR_LineUpd(FT_EN_08x16, F_F, 4, 48,"400 days from now on");    break;
 212   2        }
 213   1      
 214   1        switch(lMnDat.sav_intv)
 215   1        {
 216   2          case MnDAT_INTV_01M:  lMnDat.disp_01m = 0;    break;
 217   2          case MnDAT_INTV_10M:  lMnDat.disp_10m = 0;    break;
 218   2          case MnDAT_INTV_60M:  lMnDat.disp_60m = 0;    break;
 219   2        }
 220   1      
 221   1        DLY_RunMsec(1000);
C51 COMPILER V9.55   MENU_DATA                                                             04/29/2026 17:23:07 PAGE 5   

 222   1        LOG_ResetAddr();
 223   1      
 224   1        if(lMnDat.fSave)
 225   1        {
 226   2          RTC_GetTime();
 227   2          gLg_min  = gRt.min;
 228   2          gLg_hour = gRt.hour;
 229   2          LOG_ProcData();
 230   2      
 231   2          LOG_SaveAddr1();
 232   2          LOG_SaveAddr2();
 233   2        }
 234   1      }
