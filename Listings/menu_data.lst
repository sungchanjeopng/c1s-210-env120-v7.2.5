 476          void DatDp_ProcList(U08 sel)
 477          {
 478   1        U08 i;
 479   1        U08 page = MNU_PAGE_01;
 480   1        U08 font = FT_EN_08x16;
 481   1        U08 pSel[MnDAT_LST_MAX] = {0, };
 482   1      
 483   1        pSel[sel] = TRUE;
 484   1      
 485   1        if    (sel > (MNU_LIST_NUM*2))    page = MNU_PAGE_03;
 486   1        else if (sel > (MNU_LIST_NUM*1))    page = MNU_PAGE_02;
 487   1        else                  page = MNU_PAGE_01;
 488   1      
 489   1        if    (sel > (MNU_LIST_NUM*2))    pSel[sel-(MNU_LIST_NUM*2)] = TRUE;
 490   1        else if (sel > (MNU_LIST_NUM*1))    pSel[sel-(MNU_LIST_NUM*1)] = TRUE;
 491   1        else                  pSel[sel-(MNU_LIST_NUM*0)] = TRUE;
 492   1      
 493   1      #if 1
 494   1        switch(page)
 495   1        {   
 496   2          case MNU_PAGE_01: DatDp_ListP1(pSel); break;
 497   2          default:
 498   2            return;
 499   2        }
 500   1      #else
                if(page > MNU_PAGE_01)
                  return;
              
                switch(MnSYS_GetLang())
                {
              #if 1
                  case MnSYS_LANG_LOC:
              #if defined (_FT_LANG_KR)
                    DatDp_ListKorP1(pSel);
              
              #elif defined (_FT_LANG_CN)
                    DatDp_ListChnP1(pSel);
              
C51 COMPILER V9.55   MENU_DATA                                                             04/29/2026 17:23:07 PAGE 10  

              #elif defined (_FT_LANG_JP)
                    DatDp_ListJpnP1(pSel);
              
              #endif
                    break;
              
              #else
                  case MnSYS_LANG_KOR:    DatDp_ListKorP1(pSel);    break;
                  case MnSYS_LANG_CHN:    DatDp_ListChnP1(pSel);    break;
                  case MnSYS_LANG_JPN:    DatDp_ListJpnP1(pSel);    break;
              #endif
              
                  case MnSYS_LANG_ENG:
                  default:
                    DatDp_ListEngP1(pSel);
                    break;
                }
              #endif
 532   1        for(i=(MnDAT_LST_MAX+1); i<=(MNU_LIST_NUM+1); i++)
 533   1          MnLST_DispClr(i);
 534   1      
 535   1          LDT_UpdBuff(LCD_Y_START,LCD_Y_END);
 536   1        DLY_RunMsec(100);
 537   1      }
