 601          void MnDAT_ProcMain(void)
 602          {
 603   1        U08 fDp = FALSE;
 604   1        U08 sel = MnDAT_L00_IDLE + 1;
 605   1      
 606   1        DatDp_ProcList(sel);
 607   1      
 608   1        do
 609   1        {
 610   2          if(!_SBIT_BTN_DOWN)
 611   2          {
 612   3            if(sel < (MnDAT_LST_MAX-1))   sel++;
 613   3            else              sel = MnDAT_L00_IDLE + 1;
 614   3            fDp = TRUE;
 615   3          }
 616   2      
 617   2          if(!_SBIT_BTN_UP)
 618   2          {
 619   3            if(sel > (MnDAT_L00_IDLE+1))  sel--;
 620   3            else              sel = MnDAT_LST_MAX - 1;
 621   3            fDp = TRUE;
 622   3          }
 623   2      
 624   2          if(!_SBIT_BTN_SET)
 625   2          {
 626   3            switch(sel)
 627   3            { // Page 1
 628   4              case MnDAT_L01_F_SAVE:    MnDat_SaveEn();     break;
 629   4              case MnDAT_L02_DOWNLOAD:  MnDat_Download();   break;
 630   4              case MnDAT_L03_DELETE:    MnDat_Delete();     break;
 631   4              case MnDAT_L04_SAV_INTV:  MnDat_Interval();     break;
C51 COMPILER V9.55   MENU_DATA                                                             04/29/2026 17:23:07 PAGE 12  

 632   4              case MnDAT_L05_DP_TERM:   MnDat_DpTerm();     break;
 633   4              // Page 2
 634   4            }
 635   3            fDp = TRUE;
 636   3          }
 637   2      
 638   2          if(fDp)
 639   2          {
 640   3            DatDp_ProcList(sel);
 641   3            fDp = FALSE;
 642   3          }
 643   2        }
 644   1        while(_SBIT_BTN_EXIT);
 645   1      }
