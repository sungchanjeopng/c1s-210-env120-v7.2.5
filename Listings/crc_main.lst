  55          // OLD: unsigned int CRC16(unsigned char *puchMsg, unsigned char usDataLen)
  56          U16 CRC_GetB16(U08 *p_msg, U08 size)
  57          {
  58   1        U08 i;
  59   1        U16 flag;
  60   1        U16 crc = 0xffff;
  61   1      
  62   1        while(size--)
  63   1        {
  64   2            crc ^= *p_msg++;
  65   2            for(i=0; i<8; i++)
  66   2            {
  67   3              flag = crc & 0x0001;
  68   3              crc >>= 1;
  69   3              if(flag) crc ^= POLYNORMIAL;
  70   3            }
  71   2        }
  72   1      
  73   1        return crc;
  74   1      }
