 116          void ADC_AvrgRaw(void)
 117          {
 118   1          U08 i, avg;
 119   1          U16 dummy, sum, j;
 120   1          U08 old = SFRPAGE;
 121   1      
 122   1        if(MsANL_GetCtEcho() == 0) return;
 123   1      
 124   1        if(!MEAS_GetFgAdc())    avg = MsANL_GetCtEcho();
 125   1        else            avg = MEAS_GetCtAvrg();
 126   1      
 127   1          MEM_ReadSeq_StartAddr(MEM_MRAM, gMm_addr_raw);
 128   1      
 129   1          for(j=0; j<ADC_DATA_MAX; j++) 
 130   1          {
 131   2          //MDB_PrcMain();
 132   2      
 133   2              sum = 0;
 134   2      
 135   2              for(i=0; i<avg; i++)
 136   2                  sum += MEM_ReadSeq_ByteData(MEM_MRAM);
 137   2      
 138   2          //MDB_PrcMain();
 139   2              for (i=0; i<(MnEGN_GetAdcNumb()-avg); i++) 
 140   2                  dummy += MEM_ReadSeq_ByteData(MEM_MRAM);
 141   2      
 142   2              gAd_data[j] = sum / avg;
 143   2      
 144   2          }
 145   1          MEM_RwSeq_End(MEM_MRAM);                // Max : 250000 [220000(ADC Number_MAX*ADC_DATA_MAX)+30000]
 146   1      
