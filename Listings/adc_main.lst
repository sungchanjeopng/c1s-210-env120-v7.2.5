 151          void ADC_ProcSmooth(U16 num, U16 size) 
 152          {
 153   1          U16 sum;
 154   1          U16 i, j, k;
 155   1          U08 move, cnt;
 156   1      
 157   1          cnt = 3;
 158   1      
 159   1          for(i=0; i<num; i++) 
 160   1          {
 161   2              cnt = 3;
 162   2              for(j=1; j<size; j++) 
 163   2              {
 164   3             MDB_PrcMain();
 165   3                move = 1;
 166   3                
 167   3                for (k=0; k<j; k++) 
 168   3                {
 169   4                  sum += gAd_data[j+move];
 170   4                  sum += gAd_data[j-move];
 171   4                  move++;
 172   4                }
 173   3                
 174   3                sum += gAd_data[j];
 175   3                gAd_data[j] = (U08)(sum / cnt);
 176   3                cnt += 2;
C51 COMPILER V9.55   ADC_MAIN                                                              04/29/2026 17:22:13 PAGE 4   

 177   3                sum = 0;
 178   3              }
 179   2      
 180   2              for(j= size; j<ADC_DATA_MAX-size; j++)
 181   2              {
 182   3                move = 1;
 183   3                
 184   3                for (k = 0; k < size; k++) 
 185   3                {
 186   4                  sum += gAd_data[j+move];
 187   4                  sum += gAd_data[j-move];
 188   4                  move++;
 189   4                }
 190   3                
 191   3                sum += gAd_data[j];
 192   3                gAd_data[j] = (U08)(sum / ((size * 2) + 1));
 193   3                sum = 0;
 194   3              }
 195   2      
 196   2              cnt = (size * 2) - 1;
 197   2      
 198   2              for(j=ADC_DATA_MAX-size; j<ADC_DATA_MAX; j++) 
 199   2              {
 200   3                move = 1;
 201   3                
 202   3                for(k=size; k>1; k--) 
 203   3                {
 204   4                  sum += gAd_data[j+move];
 205   4                  sum += gAd_data[j-move];
 206   4                  move++;
 207   4                }
 208   3                sum += gAd_data[j];
 209   3      
 210   3                if(cnt == 0)    gAd_data[j] = 0;
 211   3                else            gAd_data[j] = (U08)(sum / cnt);
 212   3      
 213   3                cnt -= 2;
 214   3                size--;
 215   3                sum = 0;
 216   3              }
 217   2          }
 218   1      }
