  58          U08 BTN_GetIdx(void)
  59          {
  60   1        U08 rtn = BTN_IDX_MAX;
  61   1        U08 save = SFRPAGE;
  62   1      
  63   1        SFRPAGE = CONFIG_PAGE;
  64   1      
  65   1        if     (_SBIT_BTN_PROG  == BTN_STT_PRESS) rtn = BTN_IDX_PROG;
  66   1        else if(_SBIT_BTN_SET   == BTN_STT_PRESS) rtn = BTN_IDX_SET;
  67   1        else if(_SBIT_BTN_EXIT  == BTN_STT_PRESS)   rtn = BTN_IDX_EXIT;
  68   1        else if(_SBIT_BTN_UP    == BTN_STT_PRESS) rtn = BTN_IDX_UP;
  69   1        else if(_SBIT_BTN_DOWN  == BTN_STT_PRESS)   rtn = BTN_IDX_DOWN;
  70   1        else if(_SBIT_BTN_RIGHT == BTN_STT_PRESS) rtn = BTN_IDX_RIGHT;
  71   1        else if(_SBIT_BTN_LEFT  == BTN_STT_PRESS) rtn = BTN_IDX_LEFT;
  72   1      
  73   1        SFRPAGE = save;
  74   1      
  75   1        return rtn;
  76   1      }
