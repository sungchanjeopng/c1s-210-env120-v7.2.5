  82          void BTN_DelayMsec(U32 delay)
  83          {
  84   1          U32 cnt_press = 0;
  85   1      
  86   1          while(BTN_ChkPush() && cnt_press < delay)
  87   1          {
  88   2              cnt_press++;
  89   2              DLY_RunMsec(1);
  90   2          }
  91   1      }
  92          
  93          U08 BTN_ChkLong(U08 idx, U32 delay)
  94          {
  95   1          U32 cnt_press = 0;          // OLD: U32 Cnt_Button_press_UL_L = 0;
  96   1          U08 flg_delay = FALSE;      // OLD: U08 Flag_Delay_UC_L = 0;
  97   1      
  98   1          while(BTN_GetStatus(idx) && cnt_press < delay)
  99   1          {
 100   2              cnt_press++;
 101   2              DLY_RunMsec(1);
 102   2          }
 103   1      
 104   1          if (cnt_press >= delay)
 105   1            flg_delay = TRUE;
 106   1      
 107   1          return flg_delay;
 108   1      }
