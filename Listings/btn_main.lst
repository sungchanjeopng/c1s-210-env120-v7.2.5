 110          
 111          S32 BTN_GetValue_UpDn(S32 tmpr, S32 min, S32 max, U16 step, U08 cnt)
 112          {
 113   1          if (BTN_GetStatus(BTN_IDX_UP))
 114   1          {
 115   2              if     (cnt <= 10)      tmpr +=  step;
C51 COMPILER V9.55   BTN_MAIN                                                              04/29/2026 17:22:40 PAGE 3   

 116   2              else if(cnt <  20)      tmpr += (step * 10);
 117   2              else if(cnt <  29)      tmpr += (step * 100);
 118   2              else          tmpr += (step * 1000);
 119   2          }
 120   1          else if (BTN_GetStatus(BTN_IDX_DOWN))
 121   1          {
 122   2          if     (cnt <= 10)      tmpr -=  step;
 123   2          else if(cnt <  20)      tmpr -= (step * 10);
 124   2          else if(cnt <  29)      tmpr -= (step * 100);
 125   2          else                    tmpr -= (step * 1000);
 126   2          }
 127   1      
 128   1        if(tmpr > max)       tmpr = max;
 129   1        if(tmpr < min)       tmpr = min;
 130   1      
 131   1        return tmpr;
 132   1      }
 133          
 134          U08 BTN_GetStatus(U08 idx)
 135          {
 136   1        U08 rtn = BTN_DET_IDLE;
 137   1        U08 old = SFRPAGE;
 138   1      
 139   1        SFRPAGE = CONFIG_PAGE;
 140   1      
 141   1        switch (idx)
 142   1        {
 143   2          case BTN_IDX_PROG:    if(!_SBIT_BTN_PROG)   rtn = BTN_DET_ACTV;   break;
 144   2          case BTN_IDX_SET:   if(!_SBIT_BTN_SET)    rtn = BTN_DET_ACTV;   break;
 145   2          case BTN_IDX_EXIT:    if(!_SBIT_BTN_EXIT)   rtn = BTN_DET_ACTV;   break;
 146   2          case BTN_IDX_UP:    if(!_SBIT_BTN_UP)   rtn = BTN_DET_ACTV;   break;
 147   2          case BTN_IDX_DOWN:    if(!_SBIT_BTN_DOWN)   rtn = BTN_DET_ACTV;   break;
 148   2          case BTN_IDX_RIGHT:   if(!_SBIT_BTN_RIGHT)  rtn = BTN_DET_ACTV;   break;
 149   2          case BTN_IDX_LEFT:    if(!_SBIT_BTN_LEFT)   rtn = BTN_DET_ACTV;   break;
 150   2        }
 151   1      
 152   1        SFRPAGE = old;
 153   1        return rtn;
 154   1      }
 155          
 156          U08 BTN_ChkPush(void)
 157          {
 158   1          U08 old = SFRPAGE;
 159   1          U08 key, rtn;
 160   1      
 161   1          SFRPAGE = CONFIG_PAGE;
 162   1      
 163   1          key = _SBIT_BTN_PROG & _SBIT_BTN_UP    & _SBIT_BTN_DOWN & _SBIT_BTN_SET &
 164   1            _SBIT_BTN_EXIT & _SBIT_BTN_RIGHT & _SBIT_BTN_LEFT;
 165   1      
 166   1          if(key == BTN_DET_ACTV)   rtn = BTN_STT_PRESS;
 167   1          else                        rtn = BTN_STT_RELEASE;
 168   1      
 169   1          SFRPAGE = old;
 170   1          return rtn;
 171   1      }
