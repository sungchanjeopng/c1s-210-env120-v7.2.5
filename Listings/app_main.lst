 256          void APP_ProcEvery(void)
 257          {
 258   1        PRT_ProcMain();
 259   1        MDB_PrcMain();
 260   1      
 261   1        if(!BTN_ChkPush())
 262   1          return;
 263   1      
 264   1        ScTRD_ProcMain();
 265   1      
 266   1        switch(BTN_GetIdx())
 267   1        {
 268   2          case BTN_IDX_PROG:      AppProc_EnterMenu();        break;
 269   2          case BTN_IDX_EXIT:      AppProc_EnterQuick();       break;
 270   2          case BTN_IDX_SET:     ScTRD_ProcEnter();          break;
 271   2          case BTN_IDX_RIGHT:     AppProc_MoveScrn(BTN_IDX_RIGHT);  break;
 272   2          case BTN_IDX_LEFT:      AppProc_MoveScrn(BTN_IDX_LEFT);   break;
 273   2          default:          break;
 274   2        }
 275   1      
 276   1        switch(SCRN_GetScrnIdx())
 277   1        {
 278   2          case SCR_I02_GRP_LIVE:    BTN_DelayMsec(200);     break;
 279   2          case SCR_I03_GRP_AVRG:    MEAS_CfgThreshold();    break;
 280   2          default:          break;
 281   2        }
