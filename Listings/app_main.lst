 142          U08* APP_NumTest2Str(U32 num, U08* p_dst, U16 digit, U08 decimal, U08 f_fill_zero)
 143          {
 144   1        U08 i, cnt;
 145   1        U32 pow = 1;
 146   1      
 147   1        for(i=0; i<(digit-1); i++)
 148   1          pow *= 10;
 149   1      
 150   1        if(decimal == 0)    cnt = digit;
 151   1        else          cnt = digit + 1;
 152   1      
 153   1        for(i=0; i<cnt; i++)
 154   1        {
 155   2          if(i == (digit-decimal))
 156   2            lApp_pStr[i] = '.';
 157   2          else
 158   2          {
 159   3            if(num < pow)
 160   3            {
 161   4              if(f_fill_zero == TRUE)
 162   4                lApp_pStr[i] = '0';
 163   4              else
 164   4              {
C51 COMPILER V9.55   APP_MAIN                                                              04/29/2026 17:22:23 PAGE 4   

 165   5                if(i >= (digit-decimal-1))    lApp_pStr[i] = '0';
 166   5                else              lApp_pStr[i] = ' ';
 167   5              }
 168   4            }
 169   3            else
 170   3              lApp_pStr[i] = (num / pow) % 10 + '0';
 171   3      
 172   3            pow /= 10;
 173   3          }
 174   2        }
 175   1      
 176   1        lApp_pStr[i] = 0;
 177   1      
 178   1        strncpy(p_dst, lApp_pStr, APP_STR_LENGTH);
 179   1      
 180   1        return lApp_pStr;
 181   1      }
