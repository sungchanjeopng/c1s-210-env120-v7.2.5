 100          // OLD: void Out_DAC_SPI(unsigned int DA_dat)
C51 COMPILER V9.55   DAC_MAIN                                                              04/29/2026 17:22:08 PAGE 3   

 101          void DAC_OutSpi(U16 dat)
 102          {
 103   1        U08 out;
 104   1        U32 val;
 105   1        U08 old = SFRPAGE;
 106   1      
 107   1        SFRPAGE = SPI0_PAGE;    // Switch to the necessary SFRPAGE
 108   1        SPI0CFG = 0x50;         // CKPHA = '0', CKPOL = '1'
 109   1        SPI0CKR = 0x95;     // fspi = SYSCLK/(2*(SPI0CKR+1)) = 200kHz;
 110   1        DLY_002usec();
 111   1        DLY_002usec();
 112   1      
 113   1        SFRPAGE = CONFIG_PAGE;
 114   1        SBIT_CURR_OUT1 = 0;
 115   1        DLY_RunMsec(1);
 116   1      
 117   1        val = dat & 0x0000ffff;
 118   1      
 119   1        out = val >> 16;  SPI0_WriteByte(out);
 120   1        out = val >> 8;   SPI0_WriteByte(out);
 121   1        out = val;      SPI0_WriteByte(out);
 122   1      
 123   1        SFRPAGE = CONFIG_PAGE;
 124   1        SBIT_CURR_OUT1 = 1;
 125   1      
 126   1        SFRPAGE = SPI0_PAGE;  // Switch to the necessary SFRPAGE
 127   1        SPI0CFG = 0x40;     // CKPHA = '0', CKPOL = '0'
 128   1        DLY_002usec();
 129   1        DLY_002usec();
 130   1      
 131   1        SPI0CKR = 0x01;     // fspi = SYSCLK/(2*(SPI0CKR+1)) = 15MHz;
 132   1      
 133   1        SFRPAGE = old;
 134   1      }
 135          
 136          void DAC_OutCurr(U16 val, U08 sel)
 137          {
 138   1        U32 outp, max, min, mid;
 139   1        U32 cnt1, cnt2, range;
 140   1        U16 curr_20ma, curr_04ma;
 141   1        U16 set04mA   = MnOUT_GetSet04mA();
 142   1        U16 set20mA   = MnOUT_GetSet20mA();
 143   1        U08 trim_12mA = MnOUT_GetTrim12mA();
 144   1        U08 trim_20mA = MnOUT_GetTrim20mA();
 145   1        U08 echo_out  = MnOUT_GetEchoOut();
 146   1      #if 1
 147   1        U16 dac_04mA  = MnFTR_GetDac04mA();
 148   1        U16 dac_20mA  = MnFTR_GetDac20mA();
 149   1        U16 dac_21mA  = MnFTR_GetDac21mA();
 150   1        U16 dac_38mA  = MnFTR_GetDac38mA();
 151   1      #else
                U16 dac_04mA  = MnOUT_GetDac04mA();
                U16 dac_20mA  = MnOUT_GetDac20mA();
                U16 dac_21mA  = MnOUT_GetDac21mA();
                U16 dac_38mA  = MnOUT_GetDac38mA();
              #endif
 157   1      
 158   1        switch(MnMSR_GetUnit())
 159   1        {
 160   2          case MnMSR_UNIT_METER:
 161   2            curr_04ma = set04mA;
 162   2            curr_20ma = set20mA;
C51 COMPILER V9.55   DAC_MAIN                                                              04/29/2026 17:22:08 PAGE 4   

 163   2            break;
 164   2          case MnMSR_UNIT_FEET:
 165   2            curr_04ma = (U16)(set04mA * MSR_CALC_M2F_CONST); //+ 0.5;
 166   2            curr_20ma = (U16)(set20mA * MSR_CALC_M2F_CONST); //+ 0.5;
 167   2            break;
 168   2        }
 169   1      
 170   1        range = curr_20ma - curr_04ma;
 171   1      
 172   1        max =   dac_20mA + (trim_20mA - 50);
 173   1        mid = ((dac_20mA -  dac_04mA) / 2) + dac_04mA;
 174   1        min =   dac_04mA - (trim_20mA - 50);
 175   1        cnt2 = (max - min) * 1.0;
 176   1      
 177   1        switch(sel)
 178   1        {
 179   2          case DAC_CURR_IDX_NORMAL:
 180   2            if(val < curr_04ma)   cnt1 = 0;
 181   2            else          cnt1 = val - curr_04ma;
 182   2            outp = ((cnt1 * cnt2) / range) + min;
 183   2      
 184   2            if(outp >= max)     outp = max;
 185   2            if(outp <= min)     outp = min;
 186   2      
 187   2            if(MsANL_GetFgErr())
 188   2            {
 189   3              if(echo_out == MnOUT_ECHO_OUT_38mA)   outp = dac_38mA;
 190   3              if(echo_out == MnOUT_ECHO_OUT_HOLD)   goto DAEND;
 191   3              if(echo_out == MnOUT_ECHO_OUT_21mA)   outp = dac_21mA;
 192   3            }
 193   2            break;
 194   2      
 195   2          case DAC_CURR_IDX_04mA:   outp = min;   break;
 196   2          case DAC_CURR_IDX_12mA:   outp = mid;   break;
 197   2          case DAC_CURR_IDX_20mA:   outp = max;   break;
 198   2        }
 199   1        outp = outp + trim_12mA - 50;
 200   1        if (outp >= 65536)
 201   1          outp = 65535;
 202   1      
 203   1        DAC_OutSpi(outp);
 204   1      
 205   1        DAEND: ;
 206   1      }
