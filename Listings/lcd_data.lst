 190          // OLD: void GLCD_Horz_line(unsigned char row_UC_L, unsigned char left_UC_L, unsigned char right_UC_L)
 191          void LCD_DataLine_Horz(unsigned char row_UC_L, unsigned char left_UC_L, unsigned char right_UC_L)
 192          {
 193   1          unsigned char bit_pos;
 194   1          unsigned char byte_offset;
 195   1          unsigned char x_bits;
 196   1          unsigned char remaining_bits;
 197   1          unsigned char mask;
 198   1      
 199   1          bit_pos = left_UC_L & 0x07;      /* get starting bit offset into byte */
 200   1      
 201   1          byte_offset = left_UC_L >> 3;      /* get byte offset into y direction */
 202   1          x_bits = (right_UC_L - left_UC_L) + 1;   /* get length in the x direction to write */
 203   1          remaining_bits = 8 - bit_pos;  /* number of bits left in byte */
 204   1          mask = gLd_mask[bit_pos];  /* get mask for this bit */
 205   1      
 206   1          while(x_bits)          /* while there are still bits to write */
 207   1          {
 208   2              if((remaining_bits == 8) && (x_bits > 7))
 209   2              {
 210   3                  /* here if we are byte aligned and have at least 1 byte to write */
 211   3                  /* do the entire byte at once instead of bit by bit */
 212   3                  while(x_bits > 7)     /* while there are at least 8 more bits to do */
 213   3                  {
 214   4                      gLd_buff[row_UC_L][byte_offset] = 0xFF;
 215   4                      byte_offset++;
 216   4                      x_bits -= 8;
 217   4                  }
 218   3              }
 219   2              else
 220   2              {
 221   3                  /* we are not byte aligned or an entire byte does not need written */
 222   3                  /* do each individual bit                                          */
 223   3                  gLd_buff[row_UC_L][byte_offset] |= mask;
 224   3                  if(gLd_mask[0] & 0x80)
 225   3                  {
 226   4                    mask >>= 1;
 227   4                  }
 228   3                  else
 229   3                  {
 230   4                    mask <<= 1;
 231   4                  }
 232   3      
 233   3                  x_bits--;
 234   3                  remaining_bits--;
 235   3      
C51 COMPILER V9.55   LCD_DATA                                                              04/29/2026 17:21:48 PAGE 5   

 236   3                  if(remaining_bits == 0)
 237   3                  {
 238   4                      /* might have bust gotton byte aligned */
 239   4                      /* so reset for beginning of a byte */
 240   4                      remaining_bits = 8;
 241   4                      byte_offset++;
 242   4                      mask = gLd_mask[0];
 243   4                  }
 244   3              }
 245   2          }
 246   1      }
