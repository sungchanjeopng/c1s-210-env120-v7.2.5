  87          // OLD: void GLCD_Glyph(unsigned char left, unsigned char top, unsigned char width, unsigned char height, 
             -unsigned char *glyph, unsigned char store_width, unsigned char Flag_invert_UC_L, unsigned char space_width_UC_L)
  88          void LCD_WriteGlyph(U08 left, U08 top, U08 width, U08 height, U08 *glyph, U08 store_width, U08 Flag_invert
             -_UC_L, U08 space_width_UC_L)
  89          {
  90   1        U08 bit_pos;
  91   1        U08 byte_offset;
  92   1        U08 x_bits;
  93   1        U08 remaining_bits;
  94   1        U08 mask;
  95   1        U08 char_mask;
  96   1        U08 y;
  97   1        U08 *glyph_scan;
  98   1        U08 glyph_offset;
  99   1      
 100   1          bit_pos = left & 0x07;    /* get the bit offset into a byte */
 101   1      
 102   1          glyph_offset = 0;     /* start at top of the glyph rasters */
 103   1      
 104   1          for (y = top; y < (top + height); y++)
 105   1          {
 106   2              byte_offset = left >> 3;        /* get the byte offset into x direction,  left >> 3 = left / 8 */
 107   2              x_bits = width + space_width_UC_L + space_width_UC_L;         /* get length in y direction to write */
 108   2              remaining_bits = 8 - bit_pos; /* number of bits left in byte */
 109   2              mask = gLd_mask[bit_pos]; /* get mask for this bit */
 110   2      
 111   2              glyph_scan = glyph + glyph_offset;   /* point to start of glyph raster */
C51 COMPILER V9.55   LCD_DATA                                                              04/29/2026 17:21:48 PAGE 3   

 112   2      
 113   2              char_mask = 0x80;     /* initial character glyph mask */
 114   2      
 115   2              /* boundary checking here to account for the possibility of  */
 116   2              /* write past the right of the screen.                        */
 117   2              while((x_bits) && (byte_offset < LDT_BUFF_SIZE_X)) /* while there are bits still to write */
 118   2              {
 119   3                  if(x_bits > (width + space_width_UC_L) || x_bits <= space_width_UC_L)
 120   3                  {
 121   4                      /* check if the character pixel is set or not */
 122   4                      if(Flag_invert_UC_L == 0)
 123   4                      {
 124   5                        gLd_buff[y][byte_offset] &= ~mask;  /* clear the image pixel */
 125   5                      }
 126   4                      else
 127   4                      {
 128   5                        gLd_buff[y][byte_offset] |= mask; /* set image pixel */
 129   5                      }
 130   4                  }
 131   3                  else
 132   3                  {
 133   4                      /* check if the character pixel is set or not */
 134   4                      if(Flag_invert_UC_L == 0)
 135   4                      {
 136   5                          if(*glyph_scan & char_mask)
 137   5                          {
 138   6                            gLd_buff[y][byte_offset] |= mask; /* set image pixel */
 139   6                          }
 140   5                          else
 141   5                          {
 142   6                            gLd_buff[y][byte_offset] &= ~mask;  /* clear the image pixel */
 143   6                          }
 144   5                      }
 145   4                      else
 146   4                      {
 147   5                          if(*glyph_scan & char_mask)
 148   5                          {
 149   6                            gLd_buff[y][byte_offset] &= ~mask;  /* clear the image pixel */
 150   6                          }
 151   5                          else
 152   5                          {
 153   6                            gLd_buff[y][byte_offset] |= mask; /* set image pixel */
 154   6                          }
 155   5                      }
 156   4      
 157   4                      /* shift over to next glyph bit */
 158   4                      char_mask >>= 1;
 159   4                      if(char_mask == 0)        /* reset for next byte in raster */
 160   4                      {
 161   5                          char_mask = 0x80;
 162   5                          glyph_scan++;
 163   5                      }
 164   4                  }
 165   3      
 166   3                  if(gLd_mask[0] & 0x80)
 167   3                  {
 168   4                    mask >>= 1;
 169   4                  }
 170   3                  else
 171   3                  {
 172   4                    mask <<= 1;
 173   4                  }
C51 COMPILER V9.55   LCD_DATA                                                              04/29/2026 17:21:48 PAGE 4   

 174   3      
 175   3                  x_bits--;
 176   3                  remaining_bits--;
 177   3                  if(remaining_bits == 0)
 178   3                  {
 179   4                      /* just crossed over a byte boundry, reset byte counts */
 180   4                      remaining_bits = 8;
 181   4                      byte_offset++;
 182   4                      mask = gLd_mask[0];
 183   4                  }
 184   3              }
 185   2          /* bump the offset to next raster */
 186   2          glyph_offset += store_width;
 187   2          }
 188   1      }
