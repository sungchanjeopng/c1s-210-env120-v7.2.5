 248          // OLD: void GLCD_Box(unsigned char left, unsigned char top, unsigned char right, unsigned char bottom)
 249          void LDT_DrawBox(U08 left, U08 top, U08 right, U08 bottom)
 250          {
 251   1          /* to draw a box requires two vertical lines */
 252   1          LDT_LineVert(left,  top, bottom, LDT_LINE_DATA);
 253   1          LDT_LineVert(right, top, bottom, LDT_LINE_DATA);
 254   1          /* and two horizonal lines */
 255   1          LCD_DataLine_Horz(top, left, right);
 256   1          LCD_DataLine_Horz(bottom, left, right);
 257   1      }
