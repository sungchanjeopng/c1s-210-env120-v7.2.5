  58          // OLD: void GLCD_Vert_Dot_line(unsigned char column_UC_L, unsigned char top_UC_L, unsigned char bottom_UC
             -_L)
  59          void LCD_DataDot_LineVert(U08 column_UC_L, U08 top_UC_L, U08 bottom_UC_L)
  60          {
  61   1          U08 bit_pos, byte_offset, mask, row_UC_L;
  62   1      
  63   1          bit_pos = column_UC_L & 0x07;   /* get the bit offset into a byte */
  64   1          byte_offset = column_UC_L >> 3;   /* get the byte offset into x array */
  65   1          mask = gLd_mask[bit_pos];           /* get the mask for this bit */
  66   1      
  67   1          for(row_UC_L = top_UC_L; row_UC_L <= bottom_UC_L; row_UC_L++)
  68   1          {
  69   2              if(row_UC_L%2 == 0)     gLd_buff[row_UC_L][byte_offset] |= mask;
  70   2              else                    gLd_buff[row_UC_L][byte_offset] &= ~mask;
  71   2          }
  72   1      }
