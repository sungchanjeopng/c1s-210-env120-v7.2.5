 429          // OLD: void GLCD_Update(unsigned char top, unsigned char bottom)
 430          void LDT_UpdBuff(U08 top, U08 bottom)
 431          {
 432   1        U08 x;
 433   1        U08 y;
 434   1        U08 dat;
 435   1        U08 *p_col;
 436   1      
 437   1        for(y=top; y<=bottom; y++)
 438   1        {
 439   2          /* set addr ptr to start of line */
 440   2          LCD_TxCmd2(0x24, y*30);       /* scan the display up top to bottom */
 441   2          LCD_TxCmd0(0xB0);         /* send the auto write command */
 442   2      
 443   2          p_col = &gLd_buff[y][0];      /* point to row of data in buffer */
 444   2      
 445   2          for(x=0; x<LDT_BUFF_SIZE_X; x++)
 446   2          {
 447   3            do
 448   3              dat = LCD_GetData();
 449   3            while((dat & 0x08) != 0x08);  /* wait till STA3=1 */
 450   3      
 451   3            LCD_CfgData(*p_col++);
 452   3          }
 453   2      
 454   2          do                  /* poll loop for ready for auto reset command */
 455   2            dat = LCD_GetData();  
 456   2          while((dat & 0x08) != 0x08);    /* wait till STA2=1 */
 457   2      
 458   2          LCD_CfgCtrl(0xB2);          /* send the auto reset command */
 459   2        }
 460   1      }
