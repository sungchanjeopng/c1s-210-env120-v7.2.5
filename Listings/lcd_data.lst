 259          // OLD: void GLCD_Text(unsigned char left, unsigned char top, unsigned char font_UC_L, char *str, unsigned
             - char Flag_invert_UC_L, unsigned char space_width_UC_L)
 260          void LCD_WrStrBuff(U08 left, U08 top, U08 font, char *str, U08 f_invert, U08 space)
 261          {
 262   1        U08 code *p_glyph;
 263   1        U08 x = left;
 264   1        U08 glyph, i;
 265   1        U08 width;
 266   1        U08 height;
 267   1        U08 w_store;    // width store
 268   1        U16 tmp0, tmp1;
 269   1      
 270   1        while(*str != 0x00)
 271   1        {
 272   2          glyph = (U08)*str;
 273   2      
 274   2          /* check to make sure the symbol is a legal one */
 275   2          /* if not then just replace it with the default character */
 276   2          if((glyph < gFnt[font].glyph_beg) || (glyph > gFnt[font].glyph_end))
 277   2            glyph = gFnt[font].glyph_def;
 278   2      
 279   2          /* make zero based index into the font data arrays */
 280   2          glyph -= gFnt[font].glyph_beg;
 281   2          width  = gFnt[font].fixed_width;  /* check if it is a fixed width */
 282   2      
 283   2          if(width == 0)
 284   2            width = gFnt[font].pixel_width_table[glyph];  /* get the variable width instead */
 285   2      
 286   2          height = gFnt[font].glyph_height;
 287   2      
 288   2          //if(font == F3_EN_24x26 || font == F4_EN_26x47)
 289   2          if(font == FT_EN_26x47)
 290   2          {
 291   3            w_store = gFnt[font].char_width_table[glyph];
 292   3      
 293   3            tmp0 = 0;
 294   3            for(i = 0; i < glyph; i++)
 295   3            {
 296   4              tmp1 = gFnt[font].char_width_table[i];
C51 COMPILER V9.55   LCD_DATA                                                              04/29/2026 17:21:48 PAGE 6   

 297   4              tmp0 = tmp0 + (tmp1 * (U16)height);
 298   4            }
 299   3      
 300   3            p_glyph = gFnt[font].glyph_table + tmp0;
 301   3          }
 302   2          else
 303   2          {
 304   3            switch(font)
 305   3            {
 306   4              case FT_EN_06x07: w_store = 1;  break;
 307   4              //case F1_EN_05x08: w_store = 1;  break;
 308   4              case FT_EN_08x16: w_store = 1;  break;
 309   4              //case F5_KO_16x16: w_store = 2;  break;
 310   4              case FT_LC_16x16: w_store = 2;  break;
 311   4            }
 312   3      
 313   3            p_glyph = gFnt[font].glyph_table + ((U16)glyph * (U16)w_store * (U16)height);
 314   3          }
 315   2      
 316   2          /* range check / limit things here */
 317   2          if(x > LCD_X_END)               x = LCD_X_END;
 318   2          if((x + width + (space*2)) > (LCD_X_END + 1)) width = (LCD_X_END + 1) - x - (space*2);
 319   2      
 320   2          if(top > LCD_Y_END)               top = LCD_Y_END;
 321   2          if((top + height) > (LCD_Y_END + 1))      height = (LCD_Y_END + 1) - top;
 322   2      
 323   2          LCD_WriteGlyph(x, top, width, height, p_glyph, w_store, f_invert, space);  /* plug symbol into buffer */
 324   2      
 325   2          x = x + width + (space*2);      /* move right for next character */
 326   2          str++;                /* point to next character in string */
 327   2        }
 328   1      }
