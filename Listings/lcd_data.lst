 330          void LDT_LineVert(U08 pos_x, U08 top, U08 btm, U08 opt)
 331          {
 332   1        U08 i;
 333   1        U08 b_pos;
 334   1        U08 offset;
 335   1        U08 mask;
 336   1      
 337   1          b_pos  = pos_x & 0x07;      /* get the bit offset into a byte */
 338   1          offset = pos_x >> 3;      /* get the byte offset into x array */
 339   1          mask   = gLd_mask[b_pos];     /* get the mask for this bit */
 340   1      
 341   1        switch(opt)
 342   1        {
 343   2          case LDT_LINE_CLEAR:  for(i=top; i<=btm; i++)   gLd_buff[i][offset] &= ~mask; break;
 344   2          case LDT_LINE_DATA:   for(i=top; i<=btm; i++)   gLd_buff[i][offset] |=  mask; break;
 345   2        }
 346   1      }
