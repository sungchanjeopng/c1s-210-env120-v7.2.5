  59          // OLD: void Init_SPI0(void)
  60          void SPI_InitSPI0(void)
  61          {
  62   1        U08 SFRPAGE_save = SFRPAGE;     // Save the current SFRPAGE
  63   1      
  64   1        SFRPAGE = SPI0_PAGE;            // Switch to the necessary SFRPAGE
  65   1        SPI0CFG = 0x40;                 // Enable the SPI as a Master
  66   1                        // CKPHA = '0', CKPOL = '0'
  67   1        SPI0CN  = 0x0D;                 // 4-wire Single Master, SPI enabled
  68   1      
  69   1        SPI0CKR = 0x01;                 // fspi = SYSCLK/(2*(SPI0CKR+1)) = 15MHz;
  70   1        SFRPAGE = SFRPAGE_save;         // Restore the SFRPAGE
  71   1      }
  72          
  73          // OLD: void SPI_set(void)
  74          void SPI_SetFunc(void)
  75          {
  76   1          U08 save_sfrpage = SFRPAGE;
  77   1      
  78   1          SPI_InitSPI0();
  79   1      
  80   1          SFRPAGE = CONFIG_PAGE;
  81   1      
  82   1          XBR0 = 0x06;
  83   1          XBR2 = 0x44;
  84   1      
  85   1          SFRPAGE = save_sfrpage;
  86   1      }
  87          
  88          // OLD: void SPI_reset(void)
  89          void SPI_ResetFunc(void)
  90          {
  91   1          U08 save_sfrpage = SFRPAGE;
  92   1      
  93   1          SFRPAGE = SPI0_PAGE;                // Switch to the necessary SFRPAGE
  94   1      
  95   1          SPIEN = 0;
  96   1      
  97   1          SFRPAGE = CONFIG_PAGE;
  98   1      
  99   1          XBR0 = 0x04;
 100   1          XBR2 = 0x40;
 101   1      
 102   1          SFRPAGE = save_sfrpage;
 103   1      }
 104          
 105          // OLD: void SPI0_WriteByte(unsigned char dat_UC_L)
 106          void SPI0_WriteByte(U08 byte)
 107          {
 108   1          U08 save = SFRPAGE;
 109   1      
 110   1          SFRPAGE = SPI0_PAGE;
 111   1          SPI0DAT = byte;             // Send the command
 112   1          while (!SPIF);              // Wait for end of transfer
 113   1          SPIF  = 0;                  // Clear the SPI intr. flag
 114   1      
 115   1          SFRPAGE  = save;
C51 COMPILER V9.55   SPI_MAIN                                                              04/29/2026 17:21:56 PAGE 3   

 116   1      }
 117          
 118          // OLD: unsigned char SPI0_read(void)
 119          U08 SPI0_ReadByte(void)
 120          {
 121   1          U08 val, save = SFRPAGE;
 122   1      
 123   1          SFRPAGE = SPI0_PAGE;
 124   1          SPI0DAT = 0;                // Dummy write to output serial clock
 125   1          while (!SPIF);              // Wait for the value to be read
 126   1          SPIF = 0;                   // Clear the SPI intr. flag
 127   1      
 128   1          val = SPI0DAT;              // Store MRAM value in local var.
 129   1      
 130   1          SFRPAGE  = save;
 131   1      
 132   1          return val;
 133   1      }
 134          
 135          // OLD: void SPI0_Write_CMD(unsigned char RAM_sel_UC_L, unsigned char dat_UC_L)
 136          void SPI0_WriteCmmd(U08 sel, U08 dat)
 137          {
 138   1          U08 save = SFRPAGE;
 139   1      
 140   1          SFRPAGE = CONFIG_PAGE;
 141   1      
 142   1          if      (sel == MEM_MRAM)      SBIT_MRAM_CS = 0;
 143   1          else if (sel == MEM_SRAM)      SBIT_SRAM_CS = 0;
 144   1      
 145   1          DLY_001usec();
 146   1          SPI0_WriteByte(dat);
 147   1      
 148   1          SFRPAGE = save;
 149   1      }
 150          
 151          // OLD: void SPI0_Write_ADDR(unsigned long addr_UL_L)
 152          void SPI0_WriteAddr(U32 addr_in)
 153          {
 154   1          U08 save = SFRPAGE;
 155   1          U08 addr_0, addr_1, addr_2;
 156   1      
 157   1          addr_0 = (U08)((addr_in >> 16) & 0xFF);
 158   1          addr_1 = (U08)((addr_in >>  8) & 0xFF);
 159   1          addr_2 = (U08) (addr_in        & 0xFF);
 160   1      
 161   1          SPI0_WriteByte(addr_0);       // Send the MRAM destination address (MSB first)
 162   1          SPI0_WriteByte(addr_1);       // Send the MRAM destination address (MSB first)
 163   1          SPI0_WriteByte(addr_2);       // Send the MRAM destination address (MSB first)
 164   1      
 165   1          SFRPAGE = save;
 166   1      }
