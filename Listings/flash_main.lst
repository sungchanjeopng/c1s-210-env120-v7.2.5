 115          U08 FLS_Rd1Byte(U08 addr)
 116          {
 117   1        U08 byte;
 118   1        U08 SFRPAGE_SAVE = SFRPAGE;         // preserve SFRPAGE
 119   1        bit EA_SAVE = EA;                   // preserve EA
 120   1      
 121   1        EA = 0;                             // disable interrupts
 122   1      
 123   1        SFRPAGE = LEGACY_PAGE;
 124   1      
 125   1        PSCTL |= 0x04;                      // set SFLE
 126   1      
 127   1        pFl_read = (U08 code *) addr;
 128   1        byte = *pFl_read;                  // read the byte
 129   1      
 130   1        PSCTL &= ~0x04;                     // clear SFLE
 131   1      
 132   1        SFRPAGE = SFRPAGE_SAVE;             // restore SFRPAGE
 133   1        EA = EA_SAVE;                       // restore interrupts
 134   1      
 135   1        DLY_002usec();
 136   1      
 137   1        return byte;
 138   1      }
 139          
 140          U16 FLS_Rd2Byte(U08 addr)
 141          {
 142   1        U08 SFRPAGE_SAVE = SFRPAGE;         // preserve SFRPAGE
 143   1        bit EA_SAVE = EA;                   // preserve EA
 144   1        U08 byte_l, byte_h;
 145   1        U16 byte_2;
 146   1      
 147   1        EA = 0;                             // disable interrupts
 148   1      
 149   1        SFRPAGE = LEGACY_PAGE;
 150   1      
 151   1        PSCTL |= 0x04;                      // set SFLE
 152   1      
 153   1        pFl_read = (U08 code *) addr;
 154   1        byte_l = *pFl_read;                // read the byte
 155   1        pFl_read++;
 156   1        byte_h = *pFl_read;                // read the byte
 157   1      
 158   1        PSCTL &= ~0x04;                     // clear SFLE
 159   1      
 160   1        SFRPAGE = SFRPAGE_SAVE;             // restore SFRPAGE
 161   1        EA = EA_SAVE;                       // restore interrupts
 162   1      
C51 COMPILER V9.55   FLASH_MAIN                                                            04/29/2026 17:21:53 PAGE 4   

 163   1        byte_2 = byte_h;
 164   1        byte_2 = (byte_2 << 8) | byte_l;
 165   1      
 166   1        DLY_002usec();
 167   1      
 168   1        return byte_2;
 169   1      }
 170          
 171          void FLS_Wr1Byte(U08 addr, U08 byte)
 172          {
 173   1          U08 SFRPAGE_SAVE = SFRPAGE;         // preserve SFRPAGE
 174   1          bit EA_SAVE = EA;                   // preserve EA
 175   1      
 176   1          EA = 0;                             // disable interrupts
 177   1      
 178   1          SFRPAGE = LEGACY_PAGE;
 179   1      
 180   1          FLSCL |= 0x01;                      // enable FLASH writes/erases
 181   1          PSCTL |= 0x01;                      // PSWE = 1
 182   1          PSCTL |= 0x04;                      // set SFLE
 183   1      
 184   1          RSTSRC = 0x02;                      // enable VDDMON as reset source
 185   1      
 186   1          pFl_write  = (U08 xdata *) addr;
 187   1          *pFl_write = byte;               // write the byte
 188   1      
 189   1          PSCTL &= ~0x04;                     // clear SFLE
 190   1          PSCTL &= ~0x01;                     // PSWE = 0
 191   1          FLSCL &= ~0x01;                     // disable FLASH writes/erases
 192   1      
 193   1          SFRPAGE = SFRPAGE_SAVE;             // restore SFRPAGE
 194   1          EA = EA_SAVE;                       // restore interrupts
 195   1      
 196   1          DLY_002usec();
 197   1      }
 198          
 199          void FLS_Wr2Byte(U08 addr, U16 byte_2)
 200          {
 201   1          U08 SFRPAGE_SAVE = SFRPAGE;         // preserve SFRPAGE
 202   1          bit EA_SAVE = EA;                   // preserve EA
 203   1          U08 byte_l, byte_h;
 204   1      
 205   1          EA = 0;                             // disable interrupts
 206   1      
 207   1          byte_l = byte_2 & 0x00ff;
 208   1          byte_h = (byte_2 & 0xff00) >> 8;
 209   1      
 210   1          SFRPAGE = LEGACY_PAGE;
 211   1      
 212   1          FLSCL |= 0x01;                      // enable FLASH writes/erases
 213   1          PSCTL |= 0x01;                      // PSWE = 1
 214   1          PSCTL |= 0x04;                      // set SFLE
 215   1      
 216   1          RSTSRC = 0x02;                      // enable VDDMON as reset source
 217   1      
 218   1          pFl_write  = (U08 xdata *) addr;
 219   1          *pFl_write = byte_l;                     // write the byte
 220   1          pFl_write++;
 221   1          *pFl_write = byte_h;                     // write the byte
 222   1      
 223   1          PSCTL &= ~0x04;                     // clear SFLE
 224   1          PSCTL &= ~0x01;                     // PSWE = 0
C51 COMPILER V9.55   FLASH_MAIN                                                            04/29/2026 17:21:53 PAGE 5   

 225   1          FLSCL &= ~0x01;                     // disable FLASH writes/erases
 226   1      
 227   1          SFRPAGE = SFRPAGE_SAVE;             // restore SFRPAGE
 228   1          EA = EA_SAVE;                       // restore interrupts
 229   1      
 230   1          DLY_002usec();
 231   1      }
