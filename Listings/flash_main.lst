 273          void FLS_InitBoot(void)
 274          {
 275   1        SFRPAGE = LEGACY_PAGE;
 276   1        FLSCL = 0x30;     // Bits 5-4: FLRT: Flash Read Time. 11: SYSCLK < 100 MHz.
 277   1                    // Bit 0: FLWE: Flash Write/Erase Enable. 1: Flash writes/erases enabled.
 278   1      }
