  63          void FlPrc_ErasePage(void)
  64          {
  65   1          U08 SFRPAGE_SAVE = SFRPAGE;         // preserve SFRPAGE
  66   1          bit EA_SAVE = EA;                   // preserve EA
  67   1      
  68   1          EA = 0;                             // disable interrupts
  69   1      
  70   1          SFRPAGE = LEGACY_PAGE;
  71   1      
  72   1          FLSCL |= 0x01;                      // enable FLASH writes/erases
  73   1          PSCTL |= 0x03;                      // PSWE = 1; PSEE = 1
  74   1          PSCTL |= 0x04;                      // set SFLE
  75   1      
  76   1          RSTSRC = 0x02;                      // enable VDDMON as reset source
  77   1      
  78   1          pFl_write  = (U08 xdata *) 0x0000;
  79   1          *pFl_write = 0x00;                   // initiate page erase
  80   1          pFl_write  = (U08 xdata *) 0x00ff;
  81   1          *pFl_write = 0x00;                   // initiate page erase
  82   1      
  83   1          PSCTL &= ~0x04;                     // clear SFLE
  84   1          PSCTL &= ~0x03;                     // PSWE = 0; PSEE = 0
  85   1          FLSCL &= ~0x01;                     // disable FLASH writes/erases
  86   1      
  87   1          SFRPAGE = SFRPAGE_SAVE;             // restore SFRPAGE
  88   1          EA = EA_SAVE;                       // restore interrupts
  89   1      
  90   1          DLY_002usec();
  91   1      }
  92          
  93          void FlPrc_ReadAll(void)
  94          {
  95   1        MnSYS_MemLoad();
  96   1        MnMSR_MemLoad();
  97   1        MnOUT_MemLoad();
  98   1        MnDAT_MemLoad();
  99   1        MnEGN_MemLoad();
 100   1        MnFTR_MemLoad();
 101   1        MnTST_MemLoad();
 102   1      }
