 306          void MENU_ProcMain(void)
 307          {
 308   1        U08 sel = 1;
 309   1        U08 fDp = FALSE;
 310   1      
 311   1        DISP_ClearScr();
 312   1        MnuMain_DspList(sel);
 313   1        BTN_DelayMsec(BTN_WAIT_SET);
 314   1      
 315   1        do
 316   1        {
 317   2          if(!_SBIT_BTN_DOWN)
 318   2          {
 319   3              if(sel < (MENU_SCT_NUMB-1))   sel++;
 320   3              else                            sel = MENU_S00_IDLE +1;
 321   3            fDp = TRUE;
 322   3          }
 323   2      
 324   2          if(!_SBIT_BTN_UP)
 325   2          {
 326   3              if(sel > (MENU_S00_IDLE+1))   sel--;
 327   3              else                            sel = MENU_SCT_NUMB - 1;
 328   3            fDp = TRUE;
 329   3          }
 330   2      
 331   2          if(!_SBIT_BTN_SET)
 332   2          {
C51 COMPILER V9.55   MENU_MAIN                                                             04/29/2026 17:23:03 PAGE 7   

 333   3            switch(sel)
 334   3            {
 335   4              case MENU_S01_SYSTEM:   MnSYS_ProcMain();   break;
 336   4              case MENU_S02_MEASURE:      MnMSR_ProcMain();   break;
 337   4              case MENU_S03_OUTPUT:   MnOUT_ProcMain();   break;
 338   4              case MENU_S04_DATA:     MnDAT_ProcMain();   break;
 339   4            }
 340   3      
 341   3            fDp = TRUE;
 342   3          }
 343   2      
 344   2          if(fDp)
 345   2          {
 346   3            fDp = FALSE;
 347   3            MnuMain_DspList(sel);
 348   3            BTN_DelayMsec(BTN_WAIT_SET);
 349   3          }
 350   2        }
 351   1        while(_SBIT_BTN_EXIT);
 352   1      
 353   1        MnProc_ExitSection();
 354   1      }
