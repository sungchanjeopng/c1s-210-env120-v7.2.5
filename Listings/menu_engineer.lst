 101          void MnEgn_TrhdMin(void) 
 102          {
 103   1        F32 calc;
 104   1        U08 volt;
 105   1        U08 cnt = 0;
 106   1        S16 old = lMnEgn.trhd_min;
 107   1        S16 sel = old;
 108   1      
 109   1        MnBOX_DispBox();
 110   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X11, MnBOX_Y01, F_F, "MIN");
 111   1        DpSTR_NumbUpd(MnBOX_Y02, sel, MnEGN_TRHD_MIN_MAX, 0, F_F, "");
 112   1      
 113   1        calc = (sel * MnEGN_TRHD_VOL_MAX) / MnEGN_TRHD_MIN_MAX;
 114   1        volt = calc;
 115   1        DpSTR_NumbUpd(MnBOX_Y03, volt, MnEGN_TRHD_VOL_MAX, 2, 0, "V");
 116   1        BTN_DelayMsec(BTN_WAIT_SET);
 117   1      
 118   1        do
 119   1        {
 120   2          if(!_SBIT_BTN_UP || !_SBIT_BTN_DOWN)
 121   2          {
 122   3            if(++cnt >= 30)
 123   3              cnt = 30;
 124   3      
 125   3            sel = BTN_GetValue_UpDn(sel, MnEGN_TRHD_MIN_MIN, MnEGN_TRHD_MIN_MAX, MnEGN_TRHD_MIN_STP, cnt);
 126   3            DpSTR_NumbUpd(MnBOX_Y02, sel, MnEGN_TRHD_MIN_MAX, 0, 0, "");
 127   3      
 128   3            calc = (sel * MnEGN_TRHD_VOL_MAX) / MnEGN_TRHD_MIN_MAX;
 129   3            volt = calc;
 130   3            DpSTR_NumbUpd(MnBOX_Y03, volt, MnEGN_TRHD_VOL_MAX, 2, 0, "V");
 131   3            BTN_DelayMsec(BTN_WAIT_UD);
 132   3          }
 133   2          else
 134   2            cnt = 0;
 135   2        }
 136   1        while(_SBIT_BTN_SET && _SBIT_BTN_EXIT);
 137   1      
 138   1        if(!_SBIT_BTN_EXIT)
 139   1        {
 140   2          lMnEgn.trhd_min = old;
 141   2          return;
 142   2        }
 143   1      
 144   1        if(sel != old)
 145   1          lMnEgn.trhd_min = sel;
 146   1      }
