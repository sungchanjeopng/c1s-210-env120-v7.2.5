 606          void MnEGN_ProcMain(void)
 607          {
 608   1        U32 cnt = 0;
 609   1        U08 fDp = FALSE;
 610   1        U08 sel = MnEGN_L00_IDLE + 1;
 611   1      
 612   1        MnEngDp_List(sel);
 613   1      
 614   1        do
 615   1        {
 616   2              if(!_SBIT_BTN_DOWN)
 617   2              {
 618   3                if(sel < MnEGN_LST_MAX-1)   sel++;
 619   3                else                            sel = MnEGN_L00_IDLE+1;
 620   3            fDp = TRUE;
 621   3              }
 622   2      
 623   2              if(!_SBIT_BTN_UP)
 624   2              {
 625   3                if(sel > MnEGN_L00_IDLE+1)    sel--;
 626   3                else                            sel = MnEGN_LST_MAX-1;
 627   3            fDp = TRUE;
 628   3              }
 629   2          
 630   2          if(!_SBIT_BTN_RIGHT && !_SBIT_BTN_LEFT)
 631   2          {
 632   3            if(++cnt > 800000)
 633   3            {
 634   4              MnTST_ProcMain();
 635   4              cnt = 0;
 636   4              fDp = TRUE;
 637   4            }
 638   3          }
 639   2          else
 640   2            cnt = 0;
 641   2      
 642   2            if(!_SBIT_BTN_SET)
 643   2            {
 644   3            switch(sel) 
 645   3            { // Page 1
 646   4              case MnEGN_L01_PROF_NUM:  MnEgn_ProfNum();        break;
 647   4              case MnEGN_L02_SMTH_NUM:  MnEgn_SmthNum();      break;
 648   4              case MnEGN_L03_SMTH_RNG:  MnEgn_SmthRng();      break;
 649   4              case MnEGN_L04_TRHD_REF:  MnEgn_TrhdRng();      break;
C51 COMPILER V9.55   MENU_ENGINEER                                                         04/29/2026 17:23:14 PAGE 12  

 650   4              case MnEGN_L05_TRHD_MIN:  MnEgn_TrhdMin();        break;
 651   4              case MnEGN_L06_TVG_IDX:   MnEgn_TvgIdx();     break;
 652   4              case MnEGN_L07_TVG_CST:   MnEgn_TvgCst();     break;
 653   4              // Page 2
 654   4            }
 655   3            fDp = TRUE;
 656   3            }
 657   2      
 658   2          if(fDp)
 659   2          {
 660   3            MnEngDp_List(sel);
 661   3            fDp = FALSE;
 662   3          }
 663   2        }
 664   1        while(_SBIT_BTN_EXIT);
 665   1      }
