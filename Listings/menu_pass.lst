  55          U16 MnuPs_UdPass(S16 ud_aux, U08 ud_cnt)
  56          {
  57   1        U08 p_str[APP_STR_LENGTH] = {0, };
  58   1      
  59   1          if(ud_cnt < 10)
  60   1          {
  61   2              if(_SBIT_BTN_UP   == BTN_STT_PRESS)    ud_aux++;
  62   2              if(_SBIT_BTN_DOWN == BTN_STT_PRESS)    ud_aux--;
  63   2          }
  64   1      
  65   1          if((ud_cnt >= 10) && (ud_cnt < 20))
  66   1          {
  67   2              if(_SBIT_BTN_UP   == BTN_STT_PRESS)    ud_aux += 10;
  68   2              if(_SBIT_BTN_DOWN == BTN_STT_PRESS)    ud_aux -= 10;
  69   2          }
  70   1      
  71   1          if((ud_cnt >= 20) && (ud_cnt < 30))
  72   1          {
  73   2      
  74   2              if(_SBIT_BTN_UP   == BTN_STT_PRESS)    ud_aux += 100;
  75   2              if(_SBIT_BTN_DOWN == BTN_STT_PRESS)    ud_aux -= 100;
  76   2          }
  77   1        if(ud_cnt>= 30)
  78   1        {
  79   2              ud_cnt = 30;
  80   2      
  81   2              if(_SBIT_BTN_UP   == BTN_STT_PRESS)    ud_aux += 1000;
  82   2              if(_SBIT_BTN_DOWN == BTN_STT_PRESS)    ud_aux -= 1000;
  83   2      
  84   2        }
  85   1        
  86   1        
  87   1      
  88   1          if(ud_aux >= 9999)      ud_aux = 9999;
  89   1          if(ud_aux <= 0)         ud_aux = 0;
  90   1      
  91   1        APP_Num2Str(ud_aux, p_str, 4, 0, TRUE);
  92   1        DpSTR_LineUpd(FT_EN_08x16, 0, 104, 56, p_str);
  93   1          BTN_DelayMsec(BTN_WAIT_UD);
  94   1      
  95   1          return ud_aux;
  96   1      }
