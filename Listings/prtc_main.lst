  55          void PRT_InitBoot(void)
  56          {
  57   1        U08 mdb_baud = MnOUT_GetMdbBaud();
  58   1      
  59   1        switch(MnOUT_GetProtocol())
  60   1        {
  61   2          case MnOUT_PROT_MDBS: UAT_SetBaudrate(mdb_baud);      break;
  62   2          case MnOUT_PROT_RF:   UAT_SetBaudrate(UAT_BAUD_09600);  DLY_RunMsec(1);   break;
  63   2          default:              UAT_SetBaudrate(UAT_BAUD_09600);  break;
  64   2        }
  65   1      
  66   1      }
  67          
  68          void PRT_ProcMain(void)
  69          {
  70   1        switch(MnOUT_GetProtocol())
  71   1        {
  72   2          case MnOUT_PROT_MDBS:
  73   2            ES0 = ISR_ITR_ENABLE;
  74   2            SBIT_RS485_TR = PRT_485_RX_ON;
  75   2            
  76   2            UAT_SetLevel();
  77   2            UAT_SetTmprt();
  78   2            break;
  79   2      
  80   2          default:
  81   2            ES0 = ISR_ITR_DISABLE;
  82   2            break;
  83   2        }
  84   1      }
