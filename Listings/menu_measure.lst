 798          void MnMsrAsf_CalcVari(void)
 799          {
 800   1        U16 i, idx_cursor;
 801   1        U32 cnt_asf;
 802   1        U16 cnt_thr_up, val_asf_h, val_asf_r;
 803   1        U08 flg_thr_up;
 804   1        U08 p_str[APP_STR_LENGTH] = {0, };
 805   1        U08 p_st2[APP_STR_LENGTH] = {0, };
 806   1        U08 p_st3[APP_STR_LENGTH] = {0, };
 807   1        F32 veloc    = MEAS_GetVeloc();
 808   1        U16 trhd_pct = MsANL_GetTrhdPct();
 809   1        U32 aux0 = (U32)gDp_cursor_vert * (U32)MsANL_GetEmpty();
 810   1      
 811   1        idx_cursor = aux0 / 220;
 812   1      
 813   1        flg_thr_up = 0;
 814   1        cnt_thr_up = 0;
 815   1        cnt_asf = 0;
 816   1      
 817   1        for(i=MnMSR_GetDead(); i<idx_cursor; i++) 
 818   1        {
 819   2            if(flg_thr_up == FALSE)
 820   2            {
 821   3                if(gAd_data[i] >= trhd_pct) 
 822   3                {
 823   4                    flg_thr_up = TRUE;
C51 COMPILER V9.55   MENU_MEASURE                                                          04/29/2026 17:23:27 PAGE 15  

 824   4                    cnt_thr_up++;
 825   4                }
 826   3            } 
 827   2            else 
 828   2            {
 829   3              if(gAd_data[i] >= trhd_pct)
 830   3              cnt_thr_up++;
 831   3              else
 832   3              {
 833   4                flg_thr_up = FALSE;
 834   4      
 835   4                if(lMnMsr.cAsf < cnt_thr_up)        lMnMsr.cAsf = cnt_thr_up;
 836   4                if(cnt_asf     < cnt_thr_up)    cnt_asf     = cnt_thr_up;
 837   4                
 838   4                cnt_thr_up = 0;
 839   4              }
 840   3            }
 841   2        }
 842   1      
 843   1        if(flg_thr_up == TRUE)
 844   1        {
 845   2            if(lMnMsr.cAsf < cnt_thr_up)       lMnMsr.cAsf = cnt_thr_up;
 846   2            if(cnt_asf     < cnt_thr_up)       cnt_asf = cnt_thr_up;
 847   2        }
 848   1      
 849   1        if(lMnMsr.cAsf == 0)    val_asf_h = 0;
 850   1        else                    val_asf_h = ((lMnMsr.cAsf * 2 * 10000) / veloc) + 20;
 851   1      
 852   1        if(cnt_asf == 0)        val_asf_r = 0;
 853   1        else                    val_asf_r = ((cnt_asf * 2 * 10000) / veloc) + 20;
 854   1      
 855   1        APP_Num2Str(lMnMsr.asf, p_str, 4, 0, FALSE);
 856   1        APP_Num2Str(val_asf_r,  p_st2, 4, 0, FALSE);
 857   1        APP_Num2Str(val_asf_h,  p_st3, 4, 0, FALSE);
 858   1      
 859   1        DpSTR_LineUpd(FT_EN_08x16, FALSE,  29, 0, p_str);
 860   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 116, 0, p_st2);
 861   1        DpSTR_LineUpd(FT_EN_08x16, FALSE, 203, 0, p_st3);
 862   1      }
