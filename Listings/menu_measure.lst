 349          void MsrDp_VisualCfg(U08 lst)
 350          {
 351   1          S16 old;
 352   1          U08 cnt = 0;
 353   1          S16 feet = 0;
 354   1      
 355   1          SFRPAGE = CONFIG_PAGE;
 356   1      
 357   1          MEAS_CfgSens(4);
 358   1          MEAS_PrcEcho();
 359   1      
 360   1          LDT_ClrBuff(LCD_X_START, LCD_Y_START, LCD_X_END, LCD_Y_END);
 361   1      
 362   1          switch(lst)
 363   1          {
 364   2              case MnMSR_L03_EMPTY:   old = lMnMsr.empty;   MsrDp_StrEmpty();       break;
 365   2              case MnMSR_L04_DEADZONE:  old = lMnMsr.dead;    MsrDp_StrDeadzone();      break;
 366   2              case MnMSR_L05_ECHO_AMP:  old = lMnMsr.amp;   MsrDp_StrEchoAmp();       break;
 367   2              case MnMSR_L06_FREQ:    old = lMnMsr.freq;    MsrDp_StrFreq();        break;
 368   2        }
 369   1      
 370   1          DSP_DrawEchoQ(gAd_data);
 371   1      
 372   1          LDT_UpdBuff(LCD_Y_START, LCD_Y_END);
 373   1          BTN_DelayMsec(BTN_WAIT_SET);
 374   1      
 375   1          TMR3_Start1sec();
 376   1      
 377   1          do
 378   1          {
 379   2          if(!_SBIT_BTN_UP || !_SBIT_BTN_DOWN)
 380   2          {
 381   3                  if(++cnt >= 30)
 382   3                      cnt = 30;
 383   3      
 384   3      
 385   3            MsrDp_StrCfg(lst, cnt);
 386   3      
 387   3            MEAS_CfgSens(4);
 388   3            MEAS_PrcEcho();
 389   3            DSP_DrawEchoQ(gAd_data);
 390   3            LDT_UpdBuff(LCD_Y_START, LCD_Y_END);
 391   3      
 392   3            BTN_DelayMsec(BTN_WAIT_UD);
 393   3          }
 394   2              else
 395   2            cnt = 0;
 396   2      
 397   2              if(gIsr_tm3_cnt >= 100)  // 100 = 1sec
 398   2              {
 399   3                gIsr_tm3_cnt = 0;
 400   3      
 401   3                MEAS_CfgSens(4);
 402   3                MEAS_PrcEcho();
 403   3      
 404   3                DSP_DrawEchoQ(gAd_data);
 405   3                LDT_UpdBuff(LCD_Y_START, LCD_Y_END);
 406   3              }
C51 COMPILER V9.55   MENU_MEASURE                                                          04/29/2026 17:23:27 PAGE 8   

 407   2        }
 408   1          while(_SBIT_BTN_SET && _SBIT_BTN_EXIT);
 409   1      
 410   1          if(!_SBIT_BTN_EXIT)
 411   1          {
 412   2              switch(lst)
 413   2              {
 414   3                  case MnMSR_L03_EMPTY:   lMnMsr.empty = old;   ANZ_SetEmptyPct(110); break;
 415   3                  case MnMSR_L04_DEADZONE:  lMnMsr.dead  = old;   break;
 416   3                  case MnMSR_L05_ECHO_AMP:  lMnMsr.amp = old;   break;
 417   3                  case MnMSR_L06_FREQ:    lMnMsr.freq  = old;   break;
 418   3              }
 419   2          }
 420   1      
 421   1          TMR3_Stop1sec();
 422   1      }
