 870          void LOG_ProcData(void) 
 871          {
 872   1        S16 sludge = MEAS_GetSgThick();
 873   1        S16 tmpr   = gTp_now;
 874   1      
 875   1        MEM_WriteSeq_StartAddr(MEM_MRAM, gLg_addr_main);
 876   1        MEM_WriteSeq_Byte(MEM_MRAM, gRt.yy);
 877   1        MEM_WriteSeq_Byte(MEM_MRAM, gRt.mm);
 878   1        MEM_WriteSeq_Byte(MEM_MRAM, gRt.date);
 879   1        MEM_WriteSeq_Byte(MEM_MRAM, gRt.hour);
 880   1        MEM_WriteSeq_Byte(MEM_MRAM, gRt.min);
 881   1      
