 883   1        MEM_WriteSeq_Byte(MEM_MRAM, (U08)(sludge & 0xFF));
 884   1      
 885   1        MEM_WriteSeq_Byte(MEM_MRAM, (U08)((tmpr >> 8) & 0xFF));
 886   1        MEM_WriteSeq_Byte(MEM_MRAM, (U08)(tmpr & 0xFF));
 887   1      
 888   1        MEM_RwSeq_End(MEM_MRAM);
 889   1      
 890   1        switch(MnDAT_GetSavIntv())
 891   1        {
 892   2          case MnDAT_INTV_01M:
 893   2            if(++gLg_min > 59)
 894   2            {
 895   3              gLg_hour++;
 896   3              gLg_min = 0;
 897   3            }
 898   2      
 899   2            if(gLg_hour > 23)
 900   2              gLg_hour = 0;
 901   2            break;
 902   2      
 903   2          case MnDAT_INTV_10M:
 904   2            gLg_min = gLg_min + 10;
 905   2      
 906   2            if(gLg_min > 59)
C51 COMPILER V9.55   DATA_MAIN                                                             04/29/2026 17:23:11 PAGE 16  

 907   2            {
 908   3              gLg_hour++;
 909   3              gLg_min = gLg_min - 60;
 910   3            }
 911   2      
 912   2            if(gLg_hour > 23)
 913   2              gLg_hour = 0;
 914   2            break;
 915   2      
 916   2          case MnDAT_INTV_60M:
 917   2            if(++gLg_hour > 23)
 918   2              gLg_hour = 0;
 919   2            break;
 920   2        }
 921   1      
 922   1        gLg_addr_main += 10;
 923   1      
