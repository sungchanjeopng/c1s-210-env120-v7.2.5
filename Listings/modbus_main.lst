 108          void MDB_PrcMain(void)
 109          {
 110   1        U16 dly = 0;
 111   1        U08 old = SFRPAGE;
 112   1      
 113   1        if(!gUt.f_rx)
 114   1          return;
 115   1      
C51 COMPILER V9.55   MODBUS_MAIN                                                           04/29/2026 17:22:06 PAGE 3   

 116   1        SFRPAGE = CONFIG_PAGE;
 117   1        EA    = ISR_ITR_DISABLE;
 118   1      
 119   1        switch(MnOUT_GetMdbBaud())
 120   1        {
 121   2            case MnOUT_MDB_BAUD_04800:     dly = 1682;    break;
 122   2            case MnOUT_MDB_BAUD_09600:     dly = 839;     break;
 123   2            case MnOUT_MDB_BAUD_19200:     dly = 418;     break;
 124   2        }
 125   1      
 126   1        while(dly--);
 127   1      
 128   1        SBIT_RS485_TR = PRT_485_TX_ON;
 129   1      
 130   1        if(gUt.rx_pkt[MDB_PKT_01_CMD] == MDB_CMD_03_REQ_READ)
 131   1        {
 132   2            if((gUt.rx_pkt[MDB_PKT_03_ADDR] < 3) && (gUt.rx_pkt[MDB_PKT_05_SIZE] < 4))
 133   2            {
 134   3            MDB_SetLevel();
 135   3            MDB_TxMsg(gUt.tx_pkt, (gUt.rx_pkt[MDB_PKT_05_SIZE]*2) + 5);
 136   3            }
 137   2            else if((gUt.rx_pkt[MDB_PKT_03_ADDR] > 8) && (gUt.rx_pkt[MDB_PKT_03_ADDR] < 11) &&
 138   2                (gUt.rx_pkt[MDB_PKT_05_SIZE] < 3))
 139   2            {
 140   3                MDB_SetTmprt();
 141   3                MDB_TxMsg(gUt.tx_pkt, (gUt.rx_pkt[MDB_PKT_05_SIZE]*2) + 5);
 142   3            }
 143   2        }
 144   1      
 145   1        DLY_RunMsec(5);
 146   1      
 147   1        SBIT_RS485_TR = PRT_485_RX_ON;
 148   1      
 149   1        gUt.f_rx = FALSE;
 150   1        gUt.rx_pkt[MDB_PKT_00_NULL] = 0;
 151   1      
 152   1        EA    = ISR_ITR_ENABLE;   // Interrupt Enable
 153   1        SFRPAGE = old;
 154   1      }
