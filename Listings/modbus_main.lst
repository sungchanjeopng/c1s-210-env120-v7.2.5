  60          void MDB_SetLevel(void)
  61          {
  62   1          U08 cnt, i;
  63   1      
  64   1          cnt = (gUt.rx_pkt[MDB_PKT_05_SIZE] * 2) + 3;
  65   1      
  66   1          gUt.tx_pkt[0] = MnOUT_GetMdbAddr();
  67   1          gUt.tx_pkt[1] = 0x03;
  68   1          gUt.tx_pkt[2] = gUt.rx_pkt[MDB_PKT_05_SIZE] * 2;
  69   1      
  70   1          for(i=3; i<cnt; i++)
  71   1            gUt.tx_pkt[i] = gUt_level[i + (gUt.rx_pkt[3]*2)];
  72   1      
  73   1          gCc_b16 = CRC_GetB16(gUt.tx_pkt, cnt);
  74   1      
  75   1          gUt.tx_pkt[cnt]   = (U08)((gCc_b16>>0) & 0x00ff);
  76   1          gUt.tx_pkt[cnt+1] = (U08)((gCc_b16>>8) & 0x00ff);
  77   1      }
  78          
  79          void MDB_SetTmprt(void)
  80          {
  81   1          U08 i;
  82   1          U08 dmy_0 = (gUt.rx_pkt[MDB_PKT_05_SIZE] * 2) + 3;
  83   1      
  84   1          gUt.tx_pkt[0] = MnOUT_GetMdbAddr();
  85   1          gUt.tx_pkt[1] = 0x03;
  86   1          gUt.tx_pkt[2] = gUt.rx_pkt[MDB_PKT_05_SIZE] * 2;
  87   1      
  88   1          for(i=3; i<dmy_0; i++)
  89   1              gUt.tx_pkt[i] = gUt_tmprt[i + ((gUt.rx_pkt[3] - 9) * 2)];
  90   1      
  91   1          gCc_b16 = CRC_GetB16(gUt.tx_pkt, dmy_0);
  92   1      
  93   1          gUt.tx_pkt[dmy_0]   = (U08)((gCc_b16>>0) & 0x00ff);
  94   1          gUt.tx_pkt[dmy_0+1] = (U08)((gCc_b16>>8) & 0x00ff);
  95   1      }
  96          
  97          void MDB_TxMsg(U08 *p_msg, U08 size)
  98          {
  99   1          U08 i = 0;
 100   1      
 101   1          while(size--)
 102   1          {
 103   2              UT0_TxByte(p_msg[i]);
 104   2              i++;
 105   2          }
 106   1      }
