  90          void DpSTR_NumbUpd(U08 y0, S32 val, S32 max, U08 place, U08 fSel, U08 *pStr)
  91          {
  92   1          U08 *p_addr;
  93   1          U16 column;
  94   1          U16 numb;
  95   1          U16 minus;
  96   1          U08 c_unit = 0;
  97   1        U08 p_str[APP_STR_LENGTH] = {0, };
  98   1      
  99   1          if     (max < 10)       numb = 1;
 100   1          else if(max < 100)      numb = 2;
C51 COMPILER V9.55   DISP_STRING                                                           04/29/2026 17:22:59 PAGE 3   

 101   1          else if(max < 1000)     numb = 3;
 102   1          else if(max < 10000)    numb = 4;
 103   1          else                    numb = 5;
 104   1      
 105   1          p_addr = pStr;
 106   1          while(*pStr++ != NULL)        c_unit++;
 107   1          pStr = p_addr;
 108   1      
 109   1          column = MnBOX_LEFT + ((MnBOX_WIDTH - ((numb + c_unit) * 9)) / 2);
 110   1      
 111   1          if(place != 0)
 112   1            column -= 4;
 113   1      
 114   1          if(val < 0)
 115   1          {
 116   2              minus = val * -1;
 117   2      
 118   2          APP_Num2Str(minus, p_str, numb, place, fSel);
 119   2              DpSTR_DrawLin(FT_EN_08x16, 0, column-9, y0, "-");
 120   2          }
 121   1          else
 122   1          {
 123   2          APP_Num2Str(val, p_str, numb, place, fSel);
 124   2              DpSTR_DrawLin(FT_EN_08x16, 0, column-9, y0, " ");
 125   2        }
 126   1      
 127   1        DpSTR_DrawLin(FT_EN_08x16, 0, column, y0, p_str);
 128   1      
 129   1          if(*pStr != NULL)
 130   1          {
 131   2              column = column + (numb * 9);
 132   2      
 133   2              if(place != 0)
 134   2                column += 9;
 135   2      #if 1
 136   2          DpSTR_DrawLin(FT_EN_08x16, 0, column, y0, pStr);
 137   2      #else
                      if(lMnSys.lang == MnSYS_LANG_CHN)
                    LCD_WrStrBuff(column, row, FT_LC_16x16, p_unit, 0, 0);
                      else
                    DpSTR_DrawLin(FT_EN_08x16, 0, column, row, p_unit);
              #endif
 143   2          }
 144   1      
 145   1        LDT_UpdBuff(LCD_Y_START, LCD_Y_END);
 146   1      }
