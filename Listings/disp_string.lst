  54          void DpSTR_DrawLin(U08 font, U08 fSel, U08 x, U08 y, U08 *pStr)
  55          {
  56   1        U08 space = 0;
  57   1      
  58   1        switch(font)
  59   1        {
  60   2          case FT_EN_06x07:   space = 0;    break;
  61   2          case FT_EN_08x16:   space = 0;    break;
  62   2          case FT_EN_26x47:   space = 3;    break;
  63   2          case FT_LC_16x16:   space = 0;    break;
  64   2        }
  65   1        
  66   1        LCD_WrStrBuff(x, y, font, pStr, fSel, space);
  67   1      }
  68          
  69          void DpSTR_LineUpd(U08 font, U08 f_rev, U08 x, U08 y, U08 *p_str)
  70          {
  71   1        DpSTR_DrawLin(font, f_rev, x, y, p_str);
  72   1        LDT_UpdBuff(LCD_Y_START, LCD_Y_END);
  73   1      }
  74          
  75          void DpSTR_FreqUpd(U08 sel, U08 x, U08 y)
  76          {
  77   1        switch(sel)
  78   1        {
  79   2          case MnMSR_FREQ_130K: DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "130K");    break;
  80   2          case MnMSR_FREQ_160K: DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "160K");    break;
  81   2          case MnMSR_FREQ_270K: DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "270K");    break;
  82   2          case MnMSR_FREQ_380K: DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "380K");    break;
  83   2          // Not Used
  84   2          case MnMSR_FREQ_500K:   DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "500K");    break;
  85   2          case MnMSR_FREQ_620K: DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "620K");    break;
  86   2          case MnMSR_FREQ_750K: DpSTR_LineUpd(FT_EN_08x16, 0, x, y, "750K");    break;
  87   2        }
  88   1      }
