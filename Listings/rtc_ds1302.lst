 178   1        gRt.mm   = (gRt.mm  >>4)*10 + (gRt.mm  &0x0f);
 179   1        gRt.yy   = (gRt.yy  >>4)*10 + (gRt.yy  &0x0f);
 180   1      
 181   1        SBIT_SPI_MOSI = GIO_SET_LO;
 182   1      
 183   1        SFRPAGE = old;
