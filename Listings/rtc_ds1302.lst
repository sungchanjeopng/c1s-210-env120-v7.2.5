 243          // OLD: unsigned char Time_adj(unsigned char Para_UC_L, unsigned char Y_column_UC_L, unsigned char row_UC_
             -L, unsigned char Sel_UC_L)
 244          U08 RTC_AdjTime(U08 para, U08 column, U08 row, U08 sel)
 245          {
 246   1          U16 cnt;
 247   1          S08 aux = para;
 248   1        U08 p_str[APP_STR_LENGTH] = {0, };
 249   1      
 250   1        do
 251   1          {
 252   2          DpSTR_LineUpd(FT_EN_08x16, 0, column, row, "  ");
 253   2      
 254   2          if(_SBIT_BTN_SET != BTN_STT_PRESS)
 255   2              {
 256   3            cnt = 0;
 257   3      
 258   3            while(!BTN_ChkPush() && (cnt < 200))
 259   3                  {
 260   4              cnt++;
 261   4              DLY_RunMsec(1);
 262   4            }
 263   3          }
 264   2      
 265   2          do
 266   2              {
 267   3            if(_SBIT_BTN_UP   == BTN_STT_PRESS)    aux++;
 268   3            if(_SBIT_BTN_DOWN == BTN_STT_PRESS)    aux--;
 269   3      
 270   3            switch(sel)
 271   3                  {
 272   4                      case RTC_SET_IDX_YY:
 273   4                          if     (aux > 50)       aux = 0;
 274   4                          else if(aux < 0)        aux = 50;
 275   4      
 276   4                APP_Num2Str(aux, p_str, 2, 0, TRUE);
 277   4                DpSTR_LineUpd(FT_EN_08x16, FALSE,  column, row, p_str);
 278   4                          break;
 279   4      
 280   4                      case RTC_SET_IDX_MM:
 281   4                          if     (aux > 12)       aux = 1;
 282   4                          else if(aux < 1)        aux = 12;
 283   4      
 284   4                APP_Num2Str(aux, p_str, 2, 0, TRUE);
 285   4                DpSTR_LineUpd(FT_EN_08x16, FALSE,  column, row, p_str);
 286   4                          break;
 287   4      
 288   4                      case RTC_SET_IDX_DAY:
 289   4                          if     (aux > 31)       aux = 1;
 290   4                          else if(aux < 1)        aux = 31;
 291   4                APP_Num2Str(aux, p_str, 2, 0, TRUE);
 292   4                DpSTR_LineUpd(FT_EN_08x16, FALSE,  column, row, p_str);
 293   4                          break;
 294   4      
 295   4                      case RTC_SET_IDX_H24:
 296   4                          if     (aux > 23)       aux = 0;
 297   4                          else if(aux < 0)        aux = 23;
 298   4      
 299   4                APP_Num2Str(aux, p_str, 2, 0, TRUE);
C51 COMPILER V9.55   RTC_DS1302                                                            04/29/2026 17:22:50 PAGE 6   

 300   4                DpSTR_LineUpd(FT_EN_08x16, FALSE,  column, row, p_str);
 301   4                          break;
 302   4      
 303   4                      case RTC_SET_IDX_MIN:
 304   4                          if     (aux > 59)       aux = 00;
 305   4                          else if(aux < 0)        aux = 59;
 306   4      
 307   4                APP_Num2Str(aux, p_str, 2, 0, TRUE);
 308   4                DpSTR_LineUpd(FT_EN_08x16, FALSE,  column, row, p_str);
 309   4                          break;
 310   4            }
 311   3      
 312   3            if(_SBIT_BTN_SET != BTN_STT_PRESS)
 313   3              BTN_DelayMsec(BTN_WAIT_UD);
 314   3          } while (_SBIT_BTN_UP == BTN_STT_PRESS || _SBIT_BTN_DOWN == BTN_STT_PRESS);
 315   2      
 316   2          if(_SBIT_BTN_SET != BTN_STT_PRESS)
 317   2              {
 318   3            cnt = 0;
 319   3            while(!BTN_ChkPush() && cnt < 200)
 320   3                  {
 321   4              cnt++;
 322   4              DLY_RunMsec(1);
 323   4            }
 324   3          }
 325   2        } while(_SBIT_BTN_SET);
 326   1      
 327   1        para = aux;
 328   1      
 329   1        return para;
 330   1      }
