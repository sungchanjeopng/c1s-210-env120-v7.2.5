 188          // OLD: void rtc_set_datetime(unsigned char Time_Min_UC_L,unsigned char Time_Hour_UC_L,unsigned char Time_
             -Date_UC_L, unsigned char Time_Month_UC_L,unsigned char Time_Day_UC_L,unsigned char Time_Year_UC_L)
 189          void RTC_SetTime(U08 min, U08 hour, U08 date, U08 mm, U08 dd, U08 yy)
 190          {
 191   1          U08 dat;
 192   1      
 193   1          SPI_ResetFunc();
 194   1      
 195   1          // sec
 196   1          RtcProc_WriteData(0x80, 0x00);
 197   1      
 198   1          // min
 199   1          dat = min;
 200   1          dat /= 10;
 201   1          min %= 10;
 202   1          min = (dat<<4) | min;
 203   1          RtcProc_WriteData(0x82, min);
 204   1      
 205   1          // hour
 206   1          dat = hour;
 207   1          dat /= 10;
 208   1          hour %= 10;
 209   1          hour = (dat<<4) | hour;
 210   1          RtcProc_WriteData(0x84, hour);
 211   1      
 212   1          // date
 213   1          dat = date;
 214   1          dat /=10;
 215   1          date %=10;
 216   1          date = (dat<<4) | date;
 217   1          RtcProc_WriteData(0x86, date);
 218   1      
 219   1          // month
 220   1          dat = mm;
 221   1          dat /=10;
 222   1          mm %=10;
 223   1          mm = (dat<<4) | mm;
 224   1          RtcProc_WriteData(0x88, mm);
 225   1      
 226   1          // day
 227   1          dat = dd;
 228   1          dat /= 10;
 229   1          dd %= 10;
 230   1          dd = (dat<<4) | dd;
 231   1          RtcProc_WriteData(0x8a, dd);
 232   1      
 233   1          // yy
 234   1          dat = yy;
 235   1          dat /= 10;
 236   1          yy %= 10;
 237   1          yy = (dat<<4) | yy;
 238   1          RtcProc_WriteData(0x8c, yy);
C51 COMPILER V9.55   RTC_DS1302                                                            04/29/2026 17:22:50 PAGE 5   

 239   1      
 240   1          SPI_SetFunc();
 241   1      }
