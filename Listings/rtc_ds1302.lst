  78          // OLD: void write_ds1302_byte(unsigned char cmd)
  79          void RtcProc_WriteByte(U08 cmd)
  80          {
  81   1          U08 i;
  82   1          U08 old = SFRPAGE;
  83   1      
  84   1          SFRPAGE = CONFIG_PAGE;
  85   1      
  86   1          for(i=0; i<=7; i++)
  87   1          {
  88   2              if(cmd & 0x01)      SBIT_SPI_MOSI = 1;
  89   2              else                SBIT_SPI_MOSI = 0;
  90   2      
  91   2              cmd = cmd >> 1;
  92   2      
  93   2              SBIT_SPI_CLK = 1;
  94   2              RtcProc_WaitDly();
  95   2              SBIT_SPI_CLK = 0;
  96   2          }
  97   1      
  98   1          SFRPAGE = old;
  99   1      }
