 157          // Old: rtc_get_datetime()
 158          void RTC_GetTime(void)
 159          {
 160   1        U08 old = SFRPAGE;
 161   1      
 162   1        SPI_ResetFunc();
 163   1        SFRPAGE = CONFIG_PAGE;
 164   1      
 165   1        gRt.sec  = RtcProc_ReadData(0x81);
 166   1        gRt.min  = RtcProc_ReadData(0x83);
 167   1        gRt.hour = RtcProc_ReadData(0x85);
 168   1        gRt.date = RtcProc_ReadData(0x87);
 169   1        gRt.dd   = RtcProc_ReadData(0x8b);
 170   1        gRt.mm   = RtcProc_ReadData(0x89);
 171   1        gRt.yy   = RtcProc_ReadData(0x8d);
 172   1      
 173   1        gRt.sec  = (gRt.sec >>4)*10 + (gRt.sec &0x0f);
 174   1        gRt.min  = (gRt.min >>4)*10 + (gRt.min &0x0f);
 175   1        gRt.hour = (gRt.hour>>4)*10 + (gRt.hour&0x0f);
 176   1        gRt.date = (gRt.date>>4)*10 + (gRt.date&0x0f);
 177   1        gRt.dd   = (gRt.dd  >>4)*10 + (gRt.dd  &0x0f);
