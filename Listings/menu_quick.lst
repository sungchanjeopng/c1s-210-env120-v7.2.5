 252          void QuiDp_ProcList(U08 sel)
 253          {
 254   1        U08 i;
 255   1        U08 page = MNU_PAGE_01;
 256   1        U08 pSel[MnQUI_LST_MAX] = {0, };
 257   1      
 258   1        pSel[sel] = TRUE;
 259   1      
 260   1        if    (sel > (MNU_LIST_NUM*2))    page = MNU_PAGE_03;
 261   1        else if (sel > (MNU_LIST_NUM*1))    page = MNU_PAGE_02;
 262   1        else                  page = MNU_PAGE_01;
 263   1      
 264   1        if    (sel > (MNU_LIST_NUM*2))    pSel[sel-(MNU_LIST_NUM*2)] = TRUE;
C51 COMPILER V9.55   MENU_QUICK                                                            04/29/2026 17:23:20 PAGE 6   

 265   1        else if (sel > (MNU_LIST_NUM*1))    pSel[sel-(MNU_LIST_NUM*1)] = TRUE;
 266   1        else                  pSel[sel-(MNU_LIST_NUM*0)] = TRUE;
 267   1      
 268   1        if(page > MNU_PAGE_01)
 269   1          return;
 270   1      
 271   1      
 272   1      #if 1
 273   1        switch(page)
 274   1        {   
 275   2          case MNU_PAGE_01: QuiDp_ListP1(pSel); break;
