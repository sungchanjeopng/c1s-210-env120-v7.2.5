 106          void Interrupt_UART0(void)
 107          interrupt 4
 108          {
 109   1        U08 old = SFRPAGE;
 110   1        U08 protocol = MnOUT_GetProtocol();
 111   1        U08 mdb_addr = MnOUT_GetMdbAddr();
 112   1      
 113   1        SFRPAGE = UART0_PAGE;
 114   1      
 115   1        if(RI0)
C51 COMPILER V9.55   ISR_MAIN                                                              04/29/2026 17:21:51 PAGE 3   

 116   1        {
 117   2          EA = 0; ES0 = 0;// ET1 = 0;
 118   2          
 119   2          SFRPAGE = TMR3_PAGE;
 120   2          TMR3CN = 0x00;
 121   2          
 122   2          SFRPAGE = UART0_PAGE;
 123   2        
 124   2          if(lIs_ut0_rx_cnt > MDB_RX_PKT_SIZE)
 125   2            lIs_ut0_rx_cnt = 0;
 126   2          
 127   2          if(protocol == MnOUT_PROT_MDBS)
 128   2          {
 129   3            do
 130   3            {
 131   4              gUt.baud_cnt = gUt.baud_cfg;
 132   4              while(!RI0 && gUt.baud_cnt--);
 133   4              
 134   4              gUt.rx_pkt[lIs_ut0_rx_cnt] = SBUF0;
 135   4              RI0 = 0;
 136   4              lIs_ut0_rx_cnt++;
 137   4            }
 138   3            while((gUt.rx_pkt[MDB_PKT_00_NULL] == mdb_addr) && (lIs_ut0_rx_cnt < 8) && gUt.baud_cnt);
 139   3            
 140   3            if((gUt.rx_pkt[MDB_PKT_00_NULL] == mdb_addr) && gUt.baud_cnt != 0)
 141   3            {
 142   4              gCc_b16 = CRC_GetB16(gUt.rx_pkt, (lIs_ut0_rx_cnt-2));
 143   4      
 144   4              if(gUt.rx_pkt[lIs_ut0_rx_cnt-2] == (U08)((gCc_b16>>0) & 0x00ff) && 
 145   4                 gUt.rx_pkt[lIs_ut0_rx_cnt-1] == (U08)((gCc_b16>>8) & 0x00ff))
 146   4              {
 147   5                gUt.f_rx = TRUE;
 148   5              }
 149   4            }
 150   3            
 151   3            lIs_ut0_rx_cnt = 0;
 152   3            gUt.baud_cnt = gUt.baud_cfg;
 153   3          }
 154   2          
 155   2          SFRPAGE = TMR3_PAGE;
 156   2          TMR3CN = 0x04;
 157   2            
 158   2          EA = 1; 
 159   2            
 160   2          if(protocol == MnOUT_PROT_MDBS) 
 161   2            ES0 = 1;  // ET1 = 1;
 162   2          
 163   2          RI0 = 0;       
 164   2        }
 165   1      
 166   1        SFRPAGE = old;
 167   1      }
