  79          void Interrupt_TIMER0(void)   // Interval: about 270 usec - 20cm
  80          interrupt 1
  81          {
  82   1        U08 old = SFRPAGE;
  83   1      
  84   1        SFRPAGE = TIMER01_PAGE;
  85   1      
  86   1        TF0 = 0;
  87   1        TH0 = 0xFE;
