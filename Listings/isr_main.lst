  89   1        MEAS_SetDacTvg();
  90   1      
  91   1        SFRPAGE = old;
  92   1      }
  93          
  94          void Interrupt_TIMER3(void)   // Interval: 10msec
  95          interrupt 14
  96          {
  97   1        U08 old = SFRPAGE;
  98   1        SFRPAGE = TMR3_PAGE;
  99   1      
 100   1        TF3 = 0;
 101   1        gIsr_tm3_cnt++;
