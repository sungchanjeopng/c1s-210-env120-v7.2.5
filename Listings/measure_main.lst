  95   1          switch(set)
  96   1          {
  97   2              case 0:     lMsr.tr_step = 1;    break; //old - TR: 1, ES: 2
  98   2              case 1:     lMsr.tr_step = 2;    break; //old - TR: 2, ES: 2
  99   2              case 2:     lMsr.tr_step = 3;    break; //old - TR: 2, ES: 2
 100   2              case 3:     lMsr.tr_step = 4;    break; //old - TR: 3, ES: 3
 101   2              case 4:     lMsr.tr_step = 5;    break; //old - TR: 3, ES: 3
 102   2          }
 103   1      
 104   1        // ES (Echo Strength)
