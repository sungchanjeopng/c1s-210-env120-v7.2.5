 412          // OLD: void Transmission(unsigned char Sel_Tx_UC_L) 
 413          void MsrCfg_ProcTx(U08 tx_sel) 
 414          {
 415   1        U08 tx_num;
 416   1        U08 old = SFRPAGE;
 417   1      
 418   1        MsrCfg_SetTx(MSR_ES_S01); // Echo Stregth
 419   1      
 420   1        if(MnMSR_GetFreq() < MnMSR_FREQ_380K) tx_num = (lMsr.tr_step * 5) + 5;
 421   1        else                  tx_num = (lMsr.tr_step + 2) * 5; 
 422   1      
 423   1        lMsr.tvg_idx = 0;
 424   1        MEAS_SetDacTvg();
 425   1      
 426   1        SFRPAGE = TIMER01_PAGE;
 427   1        TH0 = 0xFE;
 428   1        TL0 = 0xAD;
 429   1        TR0 = 1;                      // TVG curve
 430   1      
 431   1        SFRPAGE = PCA0_PAGE;
 432   1        PCA0CN = 0x40;  //CR = 1;     // Tx interval
 433   1      
 434   1        ES0 = 0;
 435   1      
 436   1        if(tx_sel == MSR_TX_RUN)
 437   1          MsrCfg_TxClk(tx_num);
 438   1      
 439   1        ES0 = 1;
 440   1      
 441   1        SFRPAGE = old;
 442   1      }
