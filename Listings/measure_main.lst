 168          
 169          void MsrCfg_CalcSos(void)      // Sound Of Speed
 170          {
 171   1        F32 dmy_0, dmy_1;
 172   1      
 173   1        //-------------- temperature correction --------------//
 174   1        // c = 1410+ temp_c*4.6 - temp_c*temp_c*0.055 + temp_c*temp_c*0.00029*temp_c;
 175   1      
 176   1        if(gTp_deg < -250 || gTp_deg > 1000)
 177   1            gTp_deg = 200;
 178   1      
 179   1        dmy_0 = gTp_deg / 10.0;
 180   1        dmy_1 = 1410 + dmy_0 * 4.6 - dmy_0 * dmy_0 * 0.055 + dmy_0 * dmy_0 * 0.00029 * dmy_0;
 181   1      
 182   1        lMsr.veloc = dmy_1;   // SOS
 183   1      }
