 554   3            
 555   3            if(MnMSR_GetTrhdPer() > MnMSR_TRHD_PCT_MAX)
 556   3              MnMSR_SetTrhdPer(MnMSR_TRHD_PCT_MAX);
 557   3          }
 558   2          
 559   2          if(!_SBIT_BTN_DOWN) 
