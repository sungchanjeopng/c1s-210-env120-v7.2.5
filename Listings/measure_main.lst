 508   1      
 509   1          lMsr.tvg_idx++;
 510   1      
 511   1          if(lMsr.tvg_idx > 59)
 512   1            lMsr.tvg_idx = 59;
 513   1      
 514   1      #if 1
 515   1        if(tvg >= MnMSR_TVG_IDX_MAX)
 516   1          tvg = MnMSR_TVG_I00_IDLE;
 517   1      
 518   1        if  (MnEGN_GetFTvgCst())  gain = MnEGN_GetCstTvg(lMsr.tvg_idx) * amp;
 519   1        else            gain = lMsr_aTvg[tvg][lMsr.tvg_idx] * amp;
 520   1      #else
                if(!MnEGN_GetFgTvgSel())  tvg= MnMSR_TVG_I06_CST;
              
                if(tvg >= MnMSR_TVG_IDX_MAX)
                  tvg = MnMSR_TVG_I00_IDLE;
              
                switch(tvg)
