 136          void MsrCfg_AdcTiming(void) 
 137          {
 138   1        F32 dmy_0, dmy_1;
 139   1        U32 dummy;
 140   1      
 141   1        dmy_1 = lMsr.veloc;
 142   1        dmy_0 = (100.0 * 2.0 * 10000000.0) / (SYS_CLK * dmy_1);
 143   1      
 144   1        dummy = dmy_0;
 145   1        lMsr.dly10cm_h = dummy / 2560;
 146   1        lMsr.dly10cm_l = (dummy % 2560) / 10;
 147   1      
 148   1        dmy_1 = lMsr.veloc;
 149   1        dmy_0 = (10.0 * 120.0 * 10000.0) / dmy_1; // 1480m/s  1Cm = 13.5135us
 150   1      
 151   1        SFRPAGE = TMR2_PAGE;
 152   1        TMR2CF = 0x08;
 153   1      
 154   1        RCAP2H = (655360 - dmy_0) / 2560;
 155   1        RCAP2L = ((655360 - dmy_0) / 10) - (RCAP2H * 256);
 156   1      
 157   1        TF2 = 0;
 158   1        TMR2H = RCAP2H;
 159   1        TMR2L = RCAP2L;
 160   1      
 161   1        //////////  ADC0 set : SPS, CH, Start of Conversion Mode(Timer2 overflow) //////////
C51 COMPILER V9.55   MEASURE_MAIN                                                          04/29/2026 17:22:29 PAGE 4   

 162   1        SFRPAGE = ADC0_PAGE;
 163   1        ADC0CF = 0x98;    // SAR CLK : 2.5 MHz
 164   1        AMX0SL = 7;
 165   1        ADC0CN = 0x8D;    //0xCD
 166   1      }
