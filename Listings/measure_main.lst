                    else            gain = lMsr_aTvg[tvg][lMsr.tvg_idx] * amp;
                    break;
                }
              #endif
 536   1        if(gain > 2000)
 537   1          gain = 2000;
 538   1          
 539   1        DAC_WriteVal(gain);
