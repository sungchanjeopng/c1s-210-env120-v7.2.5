 165          void ANZ_SetTw(void)  // Time Window
 166          {
 167   1        U08 i;
 168   1        U32 max_idx = 0;
 169   1        U32 max_wdt = 0;
 170   1        U16 max_val = 0;
 171   1        U32 tmp_wdt = 0;
 172   1        U16 signal  = MEM_ReadWord(MEM_MRAM, M_ADDR_ECHO_START);
 173   1        U08 tw_rng  = MnMSR_GetTwRng();
 174   1      
 175   1        if(signal == 0)
 176   1          return;
 177   1      
 178   1        if(!MnEGN_GetFgTwMod())
 179   1        { // First Echo TW Mode
 180   2          if((signal + tw_rng) < lMsAnl.empty)    lMsAnl.tm_wd_hi = signal + tw_rng;
 181   2          else                    lMsAnl.tm_wd_hi = lMsAnl.empty;
 182   2      
 183   2          if(signal > tw_rng)     lMsAnl.tm_wd_lo = signal - tw_rng;
 184   2          else            lMsAnl.tm_wd_lo = signal;
 185   2      
 186   2          lMsAnl.dist_mod = signal;
 187   2        }
 188   1        else
 189   1        { // Maximum Echo TW Mode
 190   2          for(i=0; i<32; i+=2) 
 191   2          {
 192   3            tmp_wdt = MEM_ReadWord(MEM_MRAM, M_ADDR_ECHO_END + i);
 193   3            
 194   3            if (tmp_wdt > max_wdt)
 195   3            {
 196   4              max_wdt = tmp_wdt;
 197   4              max_idx = M_ADDR_ECHO_START + i;
 198   4            }
 199   3          }
 200   2      
 201   2          max_val = MEM_ReadWord(MEM_MRAM, max_idx);
 202   2      
 203   2          // TW High Level Set
 204   2          if((max_val + tw_rng) < lMsAnl.empty)   lMsAnl.tm_wd_hi = max_val + tw_rng;
 205   2          else                    lMsAnl.tm_wd_hi = lMsAnl.empty;
 206   2          // TW Low Level Set
 207   2          if(max_val > tw_rng)    lMsAnl.tm_wd_lo = max_val - tw_rng;
 208   2          else            lMsAnl.tm_wd_lo = max_val;
 209   2      
 210   2          lMsAnl.dist_mod = max_val;
 211   2        }
 212   1      
 213   1        lMsAnl.fTim_win = TRUE;
 214   1        lMsAnl.fEco_trk = TRUE;
 215   1      }
