 485   1      
 486   1        if(MnMSR_GetUnit() == MnMSR_UNIT_FEET) 
 487   1        {
 488   2          feet = (lMsAnl.dista_mt * MSR_CALC_M2F_CONST) + 0.5;
 489   2          lMsAnl.dista_ft = feet;
