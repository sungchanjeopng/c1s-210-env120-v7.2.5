 540          void MsANL_ProcSignal(void) 
 541          {
 542   1        U16 i;
 543   1        U32 num = 0;    // OLD: unsigned long Cnt_Sig_num_UL_L;
 544   1        U32 cnt = 0;
 545   1        U16 w_sig = 0;    // OLD: unsigned int Width_sig_UI_L;
 546   1        U08 f_lvl = 0;    // OLD: unsigned char Flag_level_condition_UC_L;
 547   1        U32 c_width = 0;  // OLD: unsigned long Cnt_Index_width_UL_L;
 548   1        U32 stt = M_ADDR_ECHO_START;
 549   1        U32 end = M_ADDR_ECHO_END;
 550   1        F32 veloc = MEAS_GetVeloc();
 551   1      
 552   1        // Analysis Frequency
 553   1        MEM_Reset_Status();
 554   1        
 555   1        for(i=0; i<MsANL_SIG_NUM; i++) 
 556   1        {
 557   2          MDB_PrcMain();
 558   2          MEM_WriteWord(MEM_MRAM, stt+cnt, 0);
 559   2          MEM_WriteWord(MEM_MRAM, end+cnt, 0);
 560   2          cnt += 2;
 561   2        }
 562   1      
 563   1        for(i=MnMSR_GetDead(); i<ADC_DATA_MAX; i++)   // Threshold over Index, Width save
 564   1        {
 565   2          MDB_PrcMain();
 566   2          if(f_lvl == FALSE)
 567   2          {
 568   3            if(gAd_data[i] > lMsAnl.trhd_pct) 
 569   3            {
 570   4              f_lvl = TRUE;
 571   4              MEM_WriteWord(MEM_MRAM, stt+num, i);
 572   4      
 573   4              c_width++;
 574   4            }
 575   3          }
 576   2          else 
 577   2          {
 578   3            if(gAd_data[i] > lMsAnl.trhd_pct)
 579   3              c_width++;
 580   3            else
 581   3            {
 582   4              w_sig = ((c_width * 2 * 10000) / veloc);
 583   4      
 584   4              if(w_sig > (MnMSR_GetAsf() + 20)) 
 585   4              {
 586   5                MEM_WriteWord(MEM_MRAM, end + num, w_sig);
 587   5                num += 2;
 588   5              } 
 589   4              else 
 590   4                MEM_WriteWord(MEM_MRAM, stt + num, 0);
 591   4      
 592   4              f_lvl = FALSE;
 593   4              c_width = 0;
 594   4      
 595   4              if(num > (MsANL_SIG_NUM - 1) * 2) 
 596   4              {
C51 COMPILER V9.55   MEASURE_ANALYZE                                                       04/29/2026 17:22:33 PAGE 11  

 597   5                i   = ADC_DATA_MAX;
 598   5                num = (MsANL_SIG_NUM - 1) * 2;
 599   5              }
 600   4            }
 601   3          }
 602   2      
 603   2          if(f_lvl == FALSE && i > lMsAnl.empty)
 604   2            i = ADC_DATA_MAX;
 605   2        }
 606   1        MDB_PrcMain();
 607   1      
 608   1        if(f_lvl == TRUE)
 609   1        {
 610   2          w_sig = ((c_width * 2 * 10000) / veloc);
 611   2      
 612   2          if(w_sig > (MnMSR_GetAsf() + 20))   MEM_WriteWord(MEM_MRAM, end+num, w_sig);
 613   2          else                  MEM_WriteWord(MEM_MRAM, stt+num, 0);
 614   2        }
 615   1      
 616   1        lMsAnl.dist_1st = MEM_ReadWord(MEM_MRAM, stt);
 617   1      
 618   1        if(MEM_ReadWord(MEM_MRAM, stt) != 0)
 619   1          lMsAnl.fEco_dtt = TRUE;
 620   1      }
