 293          void ANZ_CalcTrshd(void)      // Threshold
 294          {
 295   1        U16 i;
 296   1        F32 aux0;
 297   1        F32 temp;
 298   1        U16 start, end;
 299   1        U16 min = 255;
 300   1        U16 max = 0;
 301   1        U16 range = 0;
 302   1        U16 dist = 0;
 303   1        U16 calc = 0;
 304   1        U32 empty  = MnMSR_GetEmpty();
 305   1        U16 dead   = MnMSR_GetDead();
 306   1        U08 tw_rng = MnMSR_GetTwRng();
 307   1        U08 ftest  = MnMSR_GetFgTest();
 308   1        U16 trhd_gab = MnEGN_GetTrhdGab();
 309   1        U08 trhd_low = MnEGN_GetTrhdLow();
 310   1        U08 th_st_rg = MnEGN_GetThStRng();
 311   1      
 312   1        if(lMsAnl.fEco_chk == TRUE)
 313   1          lMsAnl.cEcho++;
 314   1      
 315   1        if(th_st_rg == 0)
 316   1          empty = lMsAnl.empty;
 317   1        else
 318   1        {
 319   2          temp  = 1 - (th_st_rg * 0.01);
 320   2          empty = MnMSR_GetEmpty() * temp;
 321   2        }
 322   1      
 323   1        if(!MnEGN_GetFgThMod()) 
 324   1        {
 325   2          start = dead;
 326   2          end   = lMsAnl.dist_mod + MnEGN_GetTrhdRng();
 327   2        } 
 328   1        else 
 329   1        {
 330   2              dist = lMsAnl.dist_mod;
 331   2              temp = MnMSR_GetEmpty() / 100;
 332   2              calc = temp * (U16)MnEGN_GetThTwRng();
 333   2              range = tw_rng + calc;
 334   2              start = dist - range;
 335   2              end   = dist + range;
 336   2        }
 337   1        
 338   1        if(ftest)
 339   1          start = dead;
 340   1      
 341   1        if((start < dead) || (start > lMsAnl.empty))
 342   1          start = dead;
 343   1      
 344   1        if(end > lMsAnl.empty)
 345   1          end = lMsAnl.empty;
 346   1      
 347   1        if(lMsAnl.fTim_win && !ftest)
 348   1        {
C51 COMPILER V9.55   MEASURE_ANALYZE                                                       04/29/2026 17:22:33 PAGE 7   

 349   2          for(i=start; i<end; i++) 
 350   2          {
 351   3            if(gAd_data[i] > max)     max = gAd_data[i];
 352   3            if(gAd_data[i] < min)     min = gAd_data[i];
 353   3          }
 354   2        } 
 355   1          else 
 356   1          {
 357   2              for(i=dead; i<empty; i++) 
 358   2              {
 359   3                if(gAd_data[i] > max)     max = gAd_data[i];
 360   3                if(gAd_data[i] < min)     min = gAd_data[i];
 361   3              }
 362   2          }
 363   1          aux0 = MnMSR_GetTrhdPer();
 364   1      
 365   1        if(MnEGN_GetFgDzMod())
 366   1        {
 367   2          if((lMsAnl.dist_mod - dead) < 15)
 368   2            min = 22;
 369   2        }
 370   1      
 371   1        if(min > 229)     // 255*90% = 229.5
 372   1        {
 373   2          aux0 = (max * aux0) / 100.0;
 374   2          lMsAnl.trhd_pct = aux0;
 375   2        } 
 376   1        else if ((max - min) < trhd_gab)
 377   1        {
 378   2          if ((255 - min) < trhd_gab) 
 379   2          {
 380   3            aux0 = (max * aux0) / 100.0;
 381   3            lMsAnl.trhd_pct = aux0;
 382   3          } 
 383   2          else 
 384   2            lMsAnl.trhd_pct = min + trhd_gab;
 385   2        } 
 386   1        else 
 387   1        {
 388   2          aux0 = ((max - min) * aux0) / 100.0;
 389   2          lMsAnl.trhd_pct = min + aux0;
 390   2        }
 391   1      
 392   1        if(lMsAnl.trhd_pct < trhd_low)
 393   1          lMsAnl.trhd_pct = trhd_low;
 394   1      
 395   1        if(MnMSR_GetTrhdMod() == MnMSR_TRHD_MOD_AUTO)   lMsAnl.trhd_pct = lMsAnl.trhd_pct;
 396   1        else                        lMsAnl.trhd_pct = MnMSR_GetTrhdFix();
 397   1      }
