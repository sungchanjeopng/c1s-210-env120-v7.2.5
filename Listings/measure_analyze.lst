 496          void MsANL_TrackingSignal(void) 
 497          {
 498   1        U16 i;
 499   1        U16 tmp1;     // OLD: unsigned int dummy_1_UI_L;
 500   1        U32 addr_stt = M_ADDR_ECHO_START;
