 513   3            else
 514   3              lMsAnl.tm_wd_hi = lMsAnl.empty;
 515   3      
 516   3            if (MEM_ReadWord(MEM_MRAM, addr_stt + tmp1) > tw_rng)
 517   3              lMsAnl.tm_wd_lo = MEM_ReadWord(MEM_MRAM, addr_stt + tmp1) - tw_rng;
 518   3            else
 519   3              lMsAnl.tm_wd_lo = 10;
 520   3      
 521   3            i = MsANL_SIG_NUM;
 522   3            lMsAnl.fEco_trk = TRUE;
 523   3          }
 524   2        }
 525   1        MDB_PrcMain();
 526   1      
 527   1        if  (lMsAnl.fEco_trk) lMsAnl.cErr_tw = 0;
 528   1        else          lMsAnl.cErr_tw++;
 529   1      
 530   1        if(lMsAnl.cErr_tw > MnMSR_GetTwDly()) 
 531   1        {
 532   2          lMsAnl.fTim_win = FALSE;
