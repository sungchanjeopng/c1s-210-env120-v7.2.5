 399          void ANZ_CalcDamp(void) 
 400          {
 401   1        U32 i;
 402   1        U16 num;
 403   1        U32 sum;
 404   1        U32 addr_s;
 405   1        U32 addr_e;
 406   1        U32 addr_n;
 407   1      
 408   1        switch(MnMSR_GetDamp())
 409   1        {                               //  OLD
 410   2          case MnMSR_DAMP_I01_T0001:    num = 1;    break;    //  1 sec    1
C51 COMPILER V9.55   MEASURE_ANALYZE                                                       04/29/2026 17:22:33 PAGE 8   

 411   2          case MnMSR_DAMP_I02_T0010:    num = 10;   break;    // 30 sec   30
 412   2          case MnMSR_DAMP_I03_T0020:    num = 20;   break;    //  1 min   60
 413   2          case MnMSR_DAMP_I04_T0040:    num = 40;   break;    //  2 min  120  
 414   2          case MnMSR_DAMP_I05_T0100:    num = 100;    break;    //  5 min    300
 415   2          case MnMSR_DAMP_I06_T0200:    num = 200;    break;    // 10 min    600
 416   2          case MnMSR_DAMP_I07_T0600:    num = 600;    break;    // 30 min   1800
 417   2          case MnMSR_DAMP_I08_T1200:    num = 1200;   break;    // 60 min   3600
 418   2        }
 419   1      
 420   1        lMsAnl.damp_num++;
 421   1      
 422   1        addr_s = M_ADDR_DAMP_START;
 423   1        addr_e = M_ADDR_DAMP_END;
 424   1      
 425   1        for(i=addr_s+2; i<=addr_e; i+=2)
 426   1        {
 427   2          MEM_WriteWord(MEM_MRAM, i - 2, MEM_ReadWord(MEM_MRAM, i));
 428   2          MDB_PrcMain();
 429   2        }
 430   1        MDB_PrcMain();
 431   1        MEM_WriteWord(MEM_MRAM, addr_e, lMsAnl.dist_mod);
 432   1      
 433   1        MDB_PrcMain();
 434   1      
 435   1        if(lMsAnl.damp_num >= num) 
 436   1        {
 437   2          lMsAnl.damp_num = num;
 438   2          sum = 0;
 439   2          
 440   2          for(i=(addr_e - ((num - 1) * 2)); i<=addr_e; i += 2) 
 441   2          {
 442   3            sum += MEM_ReadWord(MEM_MRAM, i);
 443   3            MDB_PrcMain();
 444   3          }
 445   2          lMsAnl.dista_mt = sum / lMsAnl.damp_num;
 446   2        } 
 447   1        else
 448   1        {
 449   2          addr_n = addr_e;
 450   2          sum = 0;
 451   2          
 452   2          for(i=0; i<lMsAnl.damp_num; i++)
 453   2          {
 454   3            sum += MEM_ReadWord(MEM_MRAM, addr_n);
 455   3            addr_n -= 2;
 456   3            MDB_PrcMain();
 457   3          }
 458   2          
 459   2          lMsAnl.dista_mt = sum / lMsAnl.damp_num;
 460   2        }
 461   1      }
