  62          void RLY_InitVari(void)
  63          { 
  64   1        gRly_state_01 = RLY_STT_OFF;
  65   1        gRly_state_02 = RLY_STT_OFF;
  66   1        gRly_state_03 = RLY_STT_OFF;
  67   1      }
  68          
  69          void RLY_ProcOut(U16 dat)
  70          {
  71   1        U08 old = SFRPAGE;
  72   1      
  73   1        SFRPAGE = CONFIG_PAGE;
  74   1      
  75   1        if(MnMSR_GetUnit()==MnMSR_UNIT_FEET)
  76   1          dat = MEAS_CalcFeet2Meter(dat);
  77   1      
  78   1        //High alarm
  79   1        if     (dat >= MnOUT_GetRly1Act())    gRly_state_01 = RLY_STT_ON;
  80   1        else if(dat <  MnOUT_GetRly1Stp())    gRly_state_01 = RLY_STT_OFF;
  81   1      
  82   1        //low alarm
  83   1        if     (dat <= MnOUT_GetRly2Act())    gRly_state_02 = RLY_STT_ON;
  84   1        else if(dat >  MnOUT_GetRly2Stp())    gRly_state_02 = RLY_STT_OFF;
  85   1      
  86   1        if(MsANL_GetFgErr())    gRly_state_03 = RLY_STT_ON;
  87   1        else            gRly_state_03 = RLY_STT_OFF;
  88   1      
  89   1        SBIT_RLY1_OUT = gRly_state_01;
  90   1        SBIT_RLY2_OUT = gRly_state_02;
  91   1        SBIT_RLY3_OUT = gRly_state_03;
  92   1      
  93   1        SFRPAGE = old;
  94   1      }
