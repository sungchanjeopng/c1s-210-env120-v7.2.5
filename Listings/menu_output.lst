 127          void MnOut_TrimCurr(U08 lst)
 128          {
 129   1        U08 cnt = 0;
 130   1        S16 old, sel;
 131   1        U08 dac_opt;
 132   1      
 133   1        switch(lst)
 134   1        {
 135   2          case MnOUT_L03_TRIM_12mA: old = lMnOut.trim_12mA;   dac_opt = DAC_CURR_IDX_12mA;  break;
 136   2          case MnOUT_L04_TRIM_20mA: old = lMnOut.trim_20mA;   dac_opt = DAC_CURR_IDX_20mA;  break;
 137   2          default:          return;
 138   2        }
 139   1      
 140   1        sel = old;
 141   1      
 142   1        MnBOX_DispBox();
 143   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X10, MnBOX_Y01, F_F, "Trim");
 144   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X03, MnBOX_Y02, F_F, "(Center 50)");
 145   1      
 146   1        DAC_OutCurr(0, dac_opt);
 147   1        DpSTR_NumbUpd(MnBOX_Y03, sel, MnOUT_TRIM_CURR_MAX, 0, F_F, "");
 148   1        BTN_DelayMsec(BTN_WAIT_SET);
 149   1      
 150   1        do
 151   1        {
 152   2          if(!_SBIT_BTN_UP || !_SBIT_BTN_DOWN)
 153   2          {
 154   3            if(++cnt >= 30)
 155   3              cnt = 30;
 156   3      
 157   3            sel = BTN_GetValue_UpDn(sel, MnOUT_TRIM_CURR_MIN, MnOUT_TRIM_CURR_MAX, 1, cnt);
 158   3      
 159   3            DAC_OutCurr(0, dac_opt);
 160   3            DpSTR_NumbUpd(MnBOX_Y03, sel, MnOUT_TRIM_CURR_MAX, 0, F_F, "");
 161   3            BTN_DelayMsec(BTN_WAIT_UD);
 162   3          }
