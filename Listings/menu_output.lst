 163   2          else
 164   2            cnt = 0;
 165   2        }
 166   1        while(_SBIT_BTN_SET && _SBIT_BTN_EXIT);
 167   1      
 168   1        if(!_SBIT_BTN_SET && (sel != old))
 169   1        {
 170   2          switch(lst)
 171   2          {
 172   3            case MnOUT_L03_TRIM_12mA: lMnOut.trim_12mA = sel;   break;
 173   3            case MnOUT_L04_TRIM_20mA: lMnOut.trim_20mA = sel;   break;
 174   3          }
