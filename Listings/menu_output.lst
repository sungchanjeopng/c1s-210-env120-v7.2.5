 772          void OutDp_ProcList(U08 sel)
 773          {
 774   1        U08 i;
 775   1        U08 page = MNU_PAGE_01;
 776   1        U08 pSel[MnOUT_LST_MAX] = {0, };
 777   1      
 778   1        pSel[sel] = TRUE;
 779   1      
 780   1        if    (sel > (MNU_LIST_NUM*2))    page = MNU_PAGE_03;
 781   1        else if (sel > (MNU_LIST_NUM*1))    page = MNU_PAGE_02;
 782   1        else                  page = MNU_PAGE_01;
 783   1      
 784   1        if    (sel > (MNU_LIST_NUM*2))    pSel[sel-(MNU_LIST_NUM*2)] = TRUE;
C51 COMPILER V9.55   MENU_OUTPUT                                                           04/29/2026 17:23:23 PAGE 15  

 785   1        else if (sel > (MNU_LIST_NUM*1))    pSel[sel-(MNU_LIST_NUM*1)] = TRUE;
 786   1        else                  pSel[sel-(MNU_LIST_NUM*0)] = TRUE;
 787   1      
 788   1        if    (sel > (MNU_LIST_NUM*2))    page = MNU_PAGE_03;
 789   1        else if (sel > (MNU_LIST_NUM*1))    page = MNU_PAGE_02;
 790   1        else                  page = MNU_PAGE_01;
 791   1      
 792   1      #if 1
 793   1        switch(page)
 794   1        {
 795   2          case MNU_PAGE_01:   OutDp_ListP1(pSel);   break;
 796   2          case MNU_PAGE_02:   OutDp_ListP2(pSel);   break;
 797   2          default:
 798   2            return;
 799   2        }
 800   1      #else
                if(page > MNU_PAGE_02)
                  return;
              
                switch(MnSYS_GetLang())
                {
                  case MnSYS_LANG_LOC:
                    switch(page)
                    {
              #if defined (_FT_LANG_KR)
                      case MNU_PAGE_01:   OutDp_ListKorP1(pSel);    break;
                      case MNU_PAGE_02:   OutDp_ListKorP2(pSel);    break;
              
              #elif defined (_FT_LANG_CN)
                      case MNU_PAGE_01:   OutDp_ListChnP1(pSel);    break;
                      case MNU_PAGE_02:   OutDp_ListChnP2(pSel);    break;
              
              #elif defined (_FT_LANG_JP)
                      case MNU_PAGE_01:   OutDp_ListJpnP1(pSel);    break;
                      case MNU_PAGE_02:   OutDp_ListJpnP2(pSel);    break;
              
              #endif
                    }
              
                    break;
                  case MnSYS_LANG_ENG:
                  default:
                    switch(page)
                    {
                      case MNU_PAGE_01:   OutDp_ListEngP1(pSel);    break;
                      case MNU_PAGE_02:   OutDp_ListEngP2(pSel);    break;
                    }
                    break;
                }
              #endif
 835   1        if(page == MNU_PAGE_02)
 836   1        {
 837   2          for(i=(MnOUT_LST_MAX+1-7); i<=(MNU_LIST_NUM+1); i++)
 838   2            MnLST_DispClr(i);
 839   2        }
 840   1      
 841   1          LDT_UpdBuff(LCD_Y_START,LCD_Y_END);
 842   1        DLY_RunMsec(100);
 843   1      }
