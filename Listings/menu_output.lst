 237          void MnOut_RlyOper(U08 idx)
 238          {
 239   1        S16 feet;
 240   1        U16 meter;
 241   1        U08 maxRange  = MnFTR_GetDistMax();
 242   1      
 243   1        switch(idx)
 244   1        {
 245   2          case MnOUT_L08_R1_ACT:    meter = lMnOut.rly1_act;    break;
 246   2          case MnOUT_L09_R1_STOP:   meter = lMnOut.rly1_stp;    break;
 247   2          case MnOUT_L10_R2_ACT:    meter = lMnOut.rly2_act;    break;
 248   2          case MnOUT_L11_R2_STOP:   meter = lMnOut.rly2_stp;    break;
 249   2          default:          return;
 250   2        }
 251   1      
 252   1        MnBOX_DispBox();
 253   1        MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X09, MnBOX_Y01, F_F, "Level");
 254   1      
 255   1        switch(MnMSR_GetUnit())
 256   1        {
 257   2          case MnMSR_UNIT_METER:    MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X11, MnBOX_Y02, F_F, "(m)");    break;
 258   2          case MnMSR_UNIT_FEET:   MnBOX_DispStr(MnSYS_LANG_ENG, MnBOX_X10, MnBOX_Y02, F_F, "(ft)");   break;
 259   2        }
 260   1      
 261   1        switch(MnMSR_GetUnit())
 262   1        {
 263   2          case MnMSR_UNIT_METER:
 264   2            switch(maxRange)
 265   2            {
 266   3              case MnFTR_DIST_MAX_10m: meter = MnBOX_CfgNumb(meter, 0, MnMSR_EMPTY_MT_10_MAX, 1, 2, F_F, ""); break;
 267   3              case MnFTR_DIST_MAX_20m: meter = MnBOX_CfgNumb(meter, 0, MnMSR_EMPTY_MT_20_MAX, 1, 2, F_F, ""); break;
 268   3            }
 269   2            break;
 270   2          
 271   2          case MnMSR_UNIT_FEET:
 272   2            switch(maxRange)
 273   2            {
 274   3              case MnFTR_DIST_MAX_10m: feet  = MnBOX_CfgNumb((S32)MEAS_CalcMeter2Feet(meter), MnOUT_SET_CURR_FT_MIN,
             - MnMSR_EMPTY_FT_10_MAX, 1, 1, F_F, ""); break;
 275   3              case MnFTR_DIST_MAX_20m: feet  = MnBOX_CfgNumb((S32)MEAS_CalcMeter2Feet(meter), MnOUT_SET_CURR_FT_MIN,
             - MnMSR_EMPTY_FT_20_MAX, 1, 1, F_F, ""); break;
