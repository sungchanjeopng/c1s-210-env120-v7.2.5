 278   2            break;
 279   2        }
 280   1      
 281   1        switch(idx)
C51 COMPILER V9.55   MENU_OUTPUT                                                           04/29/2026 17:23:23 PAGE 6   

 282   1        {
 283   2          case MnOUT_L08_R1_ACT:    lMnOut.rly1_act = meter;    break;
