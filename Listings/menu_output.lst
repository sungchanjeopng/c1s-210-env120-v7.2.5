 361          void MnOut_Protocol(void)
 362          {
 363   1        U08 ft = MnSYS_LANG_ENG;
 364   1        S16 old = lMnOut.protocol;
 365   1        S16 sel = old;
 366   1      
 367   1        MnBOX_DispBox();
 368   1        MnBOX_DispStr(ft, MnBOX_X10, MnBOX_Y01, F_F, "Type");
 369   1        sel = MnBOX_SelArg4(ft, sel, MnBOX_X06, "Standard", MnBOX_X06, "   RF   ", MnBOX_X06, " Modbus ", 0, "", 
             -3);
 370   1      
 371   1        if(!_SBIT_BTN_SET && (sel != old))
 372   1          lMnOut.protocol = sel;
 373   1      
 374   1        if(lMnOut.protocol == MnOUT_PROT_RF)
 375   1        {
 376   2          MnBOX_DispBox();
 377   2          MnBOX_DispStr(ft, MnBOX_X09, MnBOX_Y01, F_F, "RF CH.");
 378   2          lMnOut.rf_ch = MnBOX_CfgNumb(lMnOut.rf_ch, MnOUT_RF_CH_MIN, MnOUT_RF_CH_MAX, 1, 0, F_F, "");
 379   2      
 380   2          UAT_SetBaudrate(1);
 381   2          DLY_RunMsec(1);
 382   2        }
 383   1        else if(lMnOut.protocol == MnOUT_PROT_MDBS)
 384   1        {
 385   2          MnBOX_DispStr(ft, MnBOX_X07, MnBOX_Y01, F_F, "Address");
 386   2          lMnOut.mdb_addr = MnBOX_CfgNumb(lMnOut.mdb_addr, MnOUT_MDB_ADDR_MIN, MnOUT_MDB_ADDR_MAX, 1, 0, F_F, "");
 387   2      
 388   2          MnBOX_DispStr(ft, MnBOX_X06, MnBOX_Y01, F_F, "  Baud  ");
 389   2          lMnOut.mdb_baud = MnBOX_SelArg4(ft, lMnOut.mdb_baud, MnBOX_X08, " 4800 ",
 390   2                                     MnBOX_X08, " 9600 ",
 391   2                                     MnBOX_X09, "19200", 0, "", 3);
 392   2          UAT_SetBaudrate(lMnOut.mdb_baud);
 393   2        }
 394   1      }
